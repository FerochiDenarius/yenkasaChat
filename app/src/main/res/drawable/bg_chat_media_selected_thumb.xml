<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/chat_picker_tile" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="@color/yenkasa_emerald" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/chat_picker_tile" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/chat_picker_stroke" />
        </shape>
    </item>
</selector>
