<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="@color/menu_design_accent_cyan"
                android:centerColor="@color/menu_design_card_fill"
                android:endColor="@color/menu_design_accent_purple" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <gradient
                android:angle="0"
                android:startColor="@color/menu_design_card_fill"
                android:endColor="@color/menu_design_card_fill_deep" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</layer-list>
