<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Background color -->
    <solid android:color="#E0E0E0" />

    <!-- Optional border -->
    <stroke
        android:width="1dp"
        android:color="#BDBDBD" />

    <!-- Size (optional, can adjust dynamically via ImageView) -->
    <size
        android:width="64dp"
        android:height="64dp" />

</shape>
