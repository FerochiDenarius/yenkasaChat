<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_conversation_surface">

    <LinearLayout
        android:id="@+id/chatContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/receiverHeaderLayout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_chat_header_card"
            android:elevation="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/imageViewBackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chat_header_icon_button"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/yenkasa_emerald" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imageViewReceiverPicture"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Receiver profile picture"
                android:src="@drawable/ic_default_profile"
                app:civ_border_color="@color/yenkasa_emerald"
                app:civ_border_width="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/imageViewBackButton"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewReceiverName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/feed_primary_text"
                android:textSize="17sp"
                app:layout_constraintBottom_toTopOf="@id/textViewOnlineStatus"
                app:layout_constraintEnd_toStartOf="@+id/imageViewVideoCall"
                app:layout_constraintStart_toEndOf="@id/imageViewReceiverPicture"
                app:layout_constraintTop_toTopOf="@id/imageViewReceiverPicture"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="Qish" />

            <ImageView
                android:id="@+id/imageViewStatusIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Online status indicator"
                android:src="@drawable/status_indicator_offline"
                app:layout_constraintBottom_toBottomOf="@id/textViewOnlineStatus"
                app:layout_constraintStart_toEndOf="@id/imageViewReceiverPicture"
                app:layout_constraintTop_toTopOf="@id/textViewOnlineStatus" />

            <TextView
                android:id="@+id/textViewOnlineStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/yenkasa_emerald"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/imageViewReceiverPicture"
                app:layout_constraintEnd_toEndOf="@id/textViewReceiverName"
                app:layout_constraintStart_toEndOf="@id/imageViewStatusIndicator"
                app:layout_constraintTop_toBottomOf="@id/textViewReceiverName"
                tools:text="Online" />

            <ImageView
                android:id="@+id/imageViewVideoCall"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chat_header_icon_button"
                android:contentDescription="Video call"
                android:padding="10dp"
                android:src="@drawable/ic_videocam"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/imageViewCall"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/yenkasa_emerald" />

            <ImageView
                android:id="@+id/imageViewCall"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chat_header_icon_button"
                android:contentDescription="Call"
                android:padding="10dp"
                android:src="@drawable/ic_call"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/imageViewMoreOptions"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/yenkasa_emerald" />

            <ImageView
                android:id="@+id/imageViewMoreOptions"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chat_header_icon_button"
                android:contentDescription="More options"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/yenkasa_emerald" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="22dp"
            android:paddingTop="12dp"
            android:paddingEnd="22dp"
            android:paddingBottom="56dp" />

        <RelativeLayout
            android:id="@+id/replyPreviewLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/reply_view_background"
            android:padding="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/buttonCancelReply"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cancel reply"
                android:src="@drawable/ic_close"
                app:tint="@color/feed_primary_text" />

            <TextView
                android:id="@+id/textViewRepliedToName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/buttonCancelReply"
                android:textColor="@color/yenkasa_emerald"
                android:textStyle="bold"
                tools:text="Replying to John Doe" />

            <TextView
                android:id="@+id/textViewRepliedToMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/textViewRepliedToName"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/buttonCancelReply"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/feed_primary_text"
                tools:text="This is the message being replied to..." />
        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mediaPreviewLayout"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_chat_header_card"
            android:elevation="6dp"
            android:padding="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:id="@+id/mediaPreviewFrame"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_feed_media"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imageMediaPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Selected media preview"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/placeholder_image" />

                <TextView
                    android:id="@+id/textMediaPreviewPlay"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_chat_floating_sticker"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <TextView
                android:id="@+id/textMediaPreviewTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/feed_primary_text"
                android:textSize="15sp"
                app:layout_constraintBottom_toTopOf="@id/textMediaPreviewSubtitle"
                app:layout_constraintEnd_toStartOf="@id/buttonCancelMediaPreview"
                app:layout_constraintStart_toEndOf="@id/mediaPreviewFrame"
                app:layout_constraintTop_toTopOf="@id/mediaPreviewFrame"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="Photo ready" />

            <TextView
                android:id="@+id/textMediaPreviewSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:text="Tap send when ready"
                android:textColor="@color/feed_secondary_text"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/mediaPreviewFrame"
                app:layout_constraintEnd_toStartOf="@id/buttonCancelMediaPreview"
                app:layout_constraintStart_toEndOf="@id/mediaPreviewFrame"
                app:layout_constraintTop_toBottomOf="@id/textMediaPreviewTitle" />

            <ImageButton
                android:id="@+id/buttonCancelMediaPreview"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_chat_header_icon_button"
                android:contentDescription="Remove selected media"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/yenkasa_emerald" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/messageInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_chat_composer_bar"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/buttonToggleAttachMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_chat_attach_button"
                android:contentDescription="Attach"
                android:padding="10dp"
                android:src="@drawable/ic_add"
                app:tint="@color/yenkasa_emerald" />

            <xyz.yenkasa.app.ui.RichContentEditText
                android:id="@+id/editTextMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center_vertical|start"
                android:hint="Type a message..."
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="5"
                android:minHeight="42dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:scrollbars="vertical"
                android:textColor="@color/chat_composer_text"
                android:textColorHint="@color/chat_composer_hint"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_chat_floating_sticker"
                android:contentDescription="Record Audio"
                android:padding="10dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chat_floating_sticker"
                android:contentDescription="Send Message"
                android:padding="10dp"
                android:src="@drawable/ic_send"
                android:visibility="gone"
                app:tint="@color/white"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/buttonEmojiShortcut"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="108dp"
        android:background="@drawable/bg_chat_floating_emoji"
        android:contentDescription="Emoji"
        android:elevation="6dp"
        android:padding="10dp"
        android:src="@drawable/ic_emoji"
        app:tint="@color/yenkasa_emerald" />

    <ImageButton
        android:id="@+id/buttonStickerShortcut"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="108dp"
        android:background="@drawable/bg_chat_floating_sticker"
        android:contentDescription="Stickers"
        android:elevation="6dp"
        android:padding="10dp"
        android:src="@drawable/ic_image"
        app:tint="@color/white" />

    <LinearLayout
        android:id="@+id/attachmentMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/rounded_popup_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/buttonAttachImage"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Attach Image"
            android:src="@drawable/ic_image"
            app:tint="@color/yenkasa_emerald" />

        <ImageButton
            android:id="@+id/buttonAttachVideo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Attach Video"
            android:src="@drawable/ic_video"
            app:tint="@color/yenkasa_emerald" />

        <ImageButton
            android:id="@+id/buttonAttachCamera"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Attach Camera"
            android:src="@drawable/ic_camera"
            app:tint="@color/yenkasa_emerald" />

        <ImageButton
            android:id="@+id/buttonAttachFile"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Attach File"
            android:src="@drawable/ic_attach_file"
            app:tint="@color/yenkasa_emerald" />

        <ImageButton
            android:id="@+id/buttonAttachLocation"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Attach Location"
            android:src="@drawable/ic_location"
            app:tint="@color/yenkasa_emerald" />

        <ImageButton
            android:id="@+id/buttonAttachContact"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Attach Contact"
            android:src="@drawable/ic_contact"
            app:tint="@color/yenkasa_emerald" />

    </LinearLayout>

</FrameLayout>
