<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/feed_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/chatRoomsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/feed_surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Yenkasa"
                android:src="@drawable/ic_logo_emblem" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chatRoomsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="Yenkasa"
                    android:textColor="@color/yenkasa_emerald"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:text="Made for Africa"
                    android:textColor="@color/feed_secondary_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnChatRoomsCamera"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_feed_icon_button"
                android:clickable="true"
                android:contentDescription="Camera"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_camera"
                app:tint="@color/yenkasa_emerald" />

            <ImageView
                android:id="@+id/btnChatRoomsMore"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_feed_icon_button"
                android:clickable="true"
                android:contentDescription="More options"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/yenkasa_emerald" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chatRoomsSearchRow"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_search"
                    app:tint="@color/yenkasa_emerald" />

                <EditText
                    android:id="@+id/inputUsername"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Type a name to start a chat"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/feed_primary_text"
                    android:textColorHint="@color/feed_secondary_text"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnChatRoomsAddShortcut"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_feed_icon_button"
                android:clickable="true"
                android:contentDescription="Add user"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_person_add"
                app:tint="@color/yenkasa_emerald" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chatRoomsFoundCard"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_chat_found_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_chat_found_icon"
                android:contentDescription="User"
                android:padding="12dp"
                android:src="@drawable/ic_person_add"
                app:tint="@color/yenkasa_emerald" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textChatRoomsFoundTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Start a chat"
                    android:textColor="@color/feed_primary_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textChatRoomsFoundSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Type a username above, then add the user to your chat list."
                    android:textColor="@color/feed_secondary_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCreateRoom"
                android:layout_width="118dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chat_primary_button"
                android:drawableStart="@drawable/ic_person_add"
                android:drawablePadding="6dp"
                android:drawableTint="@color/white"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:stateListAnimator="@null"
                android:text="Add User"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChatRooms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        tools:itemCount="6"
        tools:listitem="@layout/item_chat_room" />

    <LinearLayout
        android:id="@+id/chatRoomsBottomNav"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@drawable/bg_chat_bottom_nav"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/navChatRoomsChats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_nav_active"
            android:clickable="true"
            android:drawableTop="@drawable/ic_chat_bubble"
            android:drawablePadding="3dp"
            android:drawableTint="@color/yenkasa_amber"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Chats"
            android:textColor="@color/yenkasa_amber"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/navChatRoomsStatus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:drawableTop="@drawable/ic_message"
                android:drawablePadding="3dp"
                android:drawableTint="@color/white"
                android:fontFamily="sans-serif-medium"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Groups"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/textGroupUnreadBadge"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_group_unread_badge_blue"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="18dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/navChatRoomsCalls"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_call"
            android:drawablePadding="3dp"
            android:drawableTint="@color/white"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Announcements"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navChatRoomsSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_settings"
            android:drawablePadding="3dp"
            android:drawableTint="@color/white"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Status"
            android:textColor="@color/white"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
