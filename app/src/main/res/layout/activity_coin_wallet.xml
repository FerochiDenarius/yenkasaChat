<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coinWalletRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wallet_background"
    android:orientation="vertical"
    tools:context=".ui.CoinWalletActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp">

        <LinearLayout
            android:id="@+id/walletHeader"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnWalletBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_wallet_pill"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/wallet_primary_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Yenkasa Coin Wallet"
                    android:textColor="@color/wallet_primary_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="Secure • Decentralized • Yours"
                    android:textColor="@color/wallet_secondary_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnWalletNotifications"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_wallet_pill"
                android:contentDescription="Notifications"
                android:padding="9dp"
                android:src="@drawable/ic_bell"
                app:tint="@color/wallet_primary_text" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/walletBalanceCard"
            android:layout_width="match_parent"
            android:layout_height="184dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_wallet_hero">

            <ImageView
                android:id="@+id/imageWalletWatermark"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="6dp"
                android:alpha="0.20"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_coin" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBalanceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Balance"
                        android:textColor="#B8C7BE"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgWalletBalanceVisibility"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="Toggle balance visibility"
                        android:src="@drawable/ic_eye"
                        app:tint="#B8C7BE" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="YENKASA COINS"
                    android:textColor="@color/wallet_accent_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textWalletUsdValue"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_wallet_pill"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="≈ $0.00 USD"
                    android:textColor="@color/wallet_primary_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textWalletTotalEarned"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="Total Earned\n--"
                        android:textColor="#DDE7E1"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/textWalletTotalSpent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="Total Spent\n--"
                        android:textColor="#DDE7E1"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/textWalletTransactionsCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="Transactions\n--"
                        android:textColor="#DDE7E1"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/walletActionsRow"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTransaction"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wallet_action_card"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="4dp"
                android:stateListAnimator="@null"
                android:drawableTop="@drawable/ic_send"
                android:drawablePadding="4dp"
                android:drawableTint="@color/wallet_accent_green"
                android:text="Send\nCoins"
                android:textAllCaps="false"
                android:textColor="@color/wallet_primary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnWalletReceive"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wallet_action_card"
                android:clickable="true"
                android:drawableTop="@drawable/ic_receive"
                android:drawablePadding="4dp"
                android:drawableTint="@color/wallet_accent_green"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Receive\nCoins"
                android:textColor="@color/wallet_primary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnWalletConvert"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wallet_action_card"
                android:clickable="true"
                android:drawableTop="@drawable/ic_swap"
                android:drawablePadding="4dp"
                android:drawableTint="@color/wallet_accent_gold"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Convert\nYKC + USD"
                android:textColor="@color/wallet_primary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnWalletScan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wallet_action_card"
                android:clickable="true"
                android:drawableTop="@drawable/ic_scan"
                android:drawablePadding="4dp"
                android:drawableTint="@color/wallet_primary_text"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Scan\nPay"
                android:textColor="@color/wallet_primary_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/walletAddressCard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_wallet_address_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_wallet"
                app:tint="@color/wallet_accent_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Wallet Address"
                    android:textColor="@color/wallet_secondary_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/textWalletAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:text="ykc1q23...pending"
                    android:textColor="@color/wallet_primary_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnWalletCopyAddress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_wallet_pill"
                android:clickable="true"
                android:contentDescription="Copy wallet address"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="8dp"
                android:src="@drawable/ic_copy_wallet"
                app:tint="@color/wallet_accent_green" />

            <TextView
                android:id="@+id/textWalletExplorer"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="View on Explorer"
                android:textColor="@color/wallet_accent_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/walletTransactionTabs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabRecentTransactions"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_wallet_tab_selected"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:text="Recent Transactions"
                android:textColor="@color/wallet_accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabAllTransactions"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:text="All Transactions"
                android:textColor="@color/wallet_secondary_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnWalletFilter"
                android:layout_width="72dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_wallet_pill"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Filter"
                android:textColor="@color/wallet_primary_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewTransactions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_transaction" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/walletBottomNav"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@drawable/bg_wallet_bottom_nav"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/navWalletHome"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_wallet_nav_home"
            android:drawablePadding="4dp"
            android:drawableTint="@color/wallet_secondary_text"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Home"
            android:textColor="@color/wallet_secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navWalletExplore"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_wallet_nav_explore"
            android:drawablePadding="4dp"
            android:drawableTint="@color/wallet_secondary_text"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Explore"
            android:textColor="@color/wallet_secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navWalletWallet"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/bg_wallet_nav_active"
            android:clickable="true"
            android:drawableTop="@drawable/ic_wallet"
            android:drawablePadding="4dp"
            android:drawableTint="@color/wallet_accent_green"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Wallet"
            android:textColor="@color/wallet_accent_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navWalletRewards"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_wallet_nav_rewards"
            android:drawablePadding="4dp"
            android:drawableTint="@color/wallet_secondary_text"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Rewards"
            android:textColor="@color/wallet_secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navWalletProfile"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_wallet_nav_profile"
            android:drawablePadding="4dp"
            android:drawableTint="@color/wallet_secondary_text"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Profile"
            android:textColor="@color/wallet_secondary_text"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
