<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/post_create_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBackCreateAd"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_feed_icon_button"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/post_create_primary_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleCreateAd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="@string/create_ad_page_title"
                    android:textColor="@color/post_create_primary_text"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="@string/create_ad_page_subtitle"
                    android:textColor="@color/post_create_secondary_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_wallet_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/ykc_balance_content_description"
                    android:src="@drawable/ic_coin" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/balance_label"
                        android:textColor="@color/wallet_secondary_text"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/textAdWalletBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="@color/wallet_accent_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="12,450 YKC" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ad_surface_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_ad_soft_green"
                android:contentDescription="@string/ad_title_content_description"
                android:padding="10dp"
                android:src="@drawable/ic_post"
                app:tint="@color/yenkasa_emerald" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/create_ad_title_label"
                    android:textColor="@color/post_create_primary_text"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/inputAdTitle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/create_ad_title_hint"
                    android:inputType="textCapSentences"
                    android:maxLength="70"
                    android:maxLines="1"
                    android:textColor="@color/post_create_primary_text"
                    android:textColorHint="@color/post_create_hint"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textAdTitleCount"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/create_ad_title_count_zero"
                android:textColor="@color/post_create_secondary_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ad_surface_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_ad_soft_green"
                    android:contentDescription="@string/create_ad_media_content_description"
                    android:padding="9dp"
                    android:src="@drawable/ic_image"
                    app:tint="@color/yenkasa_emerald" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/create_ad_media_title"
                        android:textColor="@color/post_create_primary_text"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/create_ad_media_subtitle"
                        android:textColor="@color/post_create_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_create_post_secondary_button"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/previewAdImage"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ad_soft_green"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_image" />

                    <Button
                        android:id="@+id/btnUploadImage"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_ad_upload_slot"
                        android:drawableTop="@drawable/ic_upload"
                        android:drawableTint="@color/yenkasa_emerald"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null"
                        android:text="@string/select_image"
                        android:textAllCaps="false"
                        android:textColor="@color/yenkasa_emerald"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_create_post_secondary_button"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ad_soft_gold">

                        <xyz.yenkasa.app.ui.player.YenkasaVideoPlayerView
                            android:id="@+id/previewAdVideo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/imageAdVideoPlaceholder"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/upload_video_content_description"
                            android:src="@drawable/ic_video"
                            app:tint="@color/post_create_accent" />
                    </FrameLayout>

                    <Button
                        android:id="@+id/btnUploadVideo"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_ad_upload_slot"
                        android:drawableTop="@drawable/ic_upload"
                        android:drawableTint="@color/post_create_accent"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null"
                        android:text="@string/select_video"
                        android:textAllCaps="false"
                        android:textColor="@color/post_create_accent"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ad_surface_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_ad_soft_gold"
                    android:contentDescription="@string/create_ad_cta_content_description"
                    android:padding="9dp"
                    android:src="@drawable/ic_ads_plus"
                    app:tint="@color/post_create_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/create_ad_cta_title"
                        android:textColor="@color/post_create_primary_text"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/create_ad_cta_subtitle"
                        android:textColor="@color/post_create_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_ad_button_text_label"
                        android:textColor="@color/post_create_primary_text"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/inputCtaText"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/create_ad_button_text_hint"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/post_create_primary_text"
                        android:textColorHint="@color/post_create_hint"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_ad_button_url_label"
                        android:textColor="@color/post_create_primary_text"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/inputCtaUrl"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="@string/create_ad_button_url_hint"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/post_create_primary_text"
                        android:textColorHint="@color/post_create_hint"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ad_surface_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ad_soft_gold"
                android:contentDescription="@string/reward"
                android:padding="10dp"
                android:src="@drawable/ic_coin"
                app:tint="@color/post_create_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/create_ad_reward_title"
                    android:textColor="@color/post_create_primary_text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/create_ad_reward_subtitle"
                    android:textColor="@color/post_create_secondary_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/inputReward"
                android:layout_width="96dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_rounded"
                android:gravity="center"
                android:hint="@string/create_ad_reward_hint"
                android:inputType="number"
                android:maxLength="5"
                android:maxLines="1"
                android:textColor="@color/post_create_primary_text"
                android:textColorHint="@color/post_create_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ad_surface_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_ad_soft_green"
                    android:contentDescription="@string/create_ad_thumbnail_content_description"
                    android:padding="9dp"
                    android:src="@drawable/ic_image"
                    app:tint="@color/yenkasa_emerald" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/create_ad_thumbnail_title"
                        android:textColor="@color/post_create_primary_text"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/create_ad_thumbnail_subtitle"
                        android:textColor="@color/post_create_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/previewAdThumb"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_ad_upload_slot"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_image" />

            <Button
                android:id="@+id/btnUploadThumb"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_ad_upload_slot"
                android:drawableTop="@drawable/ic_upload"
                android:drawableTint="@color/yenkasa_emerald"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/select_thumbnail"
                android:textAllCaps="false"
                android:textColor="@color/yenkasa_emerald"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ad_soft_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_ad_soft_green"
                android:contentDescription="@string/create_ad_make_count_content_description"
                android:padding="8dp"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/yenkasa_emerald" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/create_ad_make_count_title"
                    android:textColor="@color/yenkasa_emerald"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/create_ad_make_count_subtitle"
                    android:textColor="@color/post_create_primary_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnSubmitAd"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_ad_submit_button"
            android:drawableStart="@drawable/ic_ads_plus"
            android:drawablePadding="8dp"
            android:drawableTint="@color/white"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="@string/submit_ad"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/create_ad_review_notice"
            android:textColor="@color/post_create_secondary_text"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
