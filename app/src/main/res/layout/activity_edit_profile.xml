<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= HEADER ================= -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:background="@color/yenkasaAmber"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <RelativeLayout
                    android:layout_width="130dp"
                    android:layout_height="130dp">

                    <ImageView
                        android:id="@+id/imageProfile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/circle_avatar"
                        android:padding="6dp"
                        android:src="@drawable/default_avatar" />

                    <ImageView
                        android:id="@+id/btnChangeImage"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/circle_icon_bg"
                        android:padding="8dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@android:color/white" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/textName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akua Ataa"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/yenkasaWhite"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+233 558 123 456"
                    android:textSize="14sp"
                    android:textColor="@color/yenkasaWhite"
                    android:alpha="0.8" />

            </LinearLayout>
        </FrameLayout>

        <!-- ================= CARD ================= -->
        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_marginTop="-60dp"
            android:padding="20dp"
            android:orientation="vertical"
            android:background="@drawable/card_rounded"
            android:elevation="4dp">

            <!-- USERNAME -->
            <TextView
                android:id="@+id/labelUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textSize="13sp"
                android:textColor="@color/inputLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/til_box_stroke"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:textSize="16sp"
                    android:textColor="@color/yenkasaBlack"
                    android:textCursorDrawable="@drawable/cursor_green"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- EMAIL -->
            <TextView
                android:id="@+id/labelEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="13sp"
                android:textColor="@color/inputLabel"
                android:layout_marginTop="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/til_box_stroke"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:textSize="16sp"
                    android:textColor="@color/yenkasaBlack"
                    android:textCursorDrawable="@drawable/cursor_green"
                    android:inputType="textEmailAddress"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- PHONE -->
            <TextView
                android:id="@+id/labelPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:textSize="13sp"
                android:textColor="@color/inputLabel"
                android:layout_marginTop="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/til_box_stroke"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:textSize="16sp"
                    android:textColor="@color/yenkasaBlack"
                    android:textCursorDrawable="@drawable/cursor_green"
                    android:inputType="phone"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- LOCATION -->
            <TextView
                android:id="@+id/labelLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="13sp"
                android:textColor="@color/inputLabel"
                android:layout_marginTop="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/til_box_stroke"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:textSize="16sp"
                    android:textColor="@color/yenkasaBlack"
                    android:textCursorDrawable="@drawable/cursor_green"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- GENDER -->
            <TextView
                android:id="@+id/labelGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gender"
                android:textSize="13sp"
                android:textColor="@color/inputLabel"
                android:layout_marginTop="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/til_box_stroke"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:textSize="16sp"
                    android:textColor="@color/yenkasaBlack"
                    android:textCursorDrawable="@drawable/cursor_green"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- DOB -->
            <TextView
                android:id="@+id/labelDob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date of Birth"
                android:textSize="13sp"
                android:textColor="@color/inputLabel"
                android:layout_marginTop="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/til_box_stroke"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editDob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:textColor="@color/yenkasaBlack"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="YYYY-MM-DD"
                    android:drawableEnd="@drawable/ic_calendar" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CHANGE PASSWORD -->
            <LinearLayout
                android:id="@+id/rowPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/row_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/yenkasaEmerald" />

                <TextView
                    android:id="@+id/textChangePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Password"
                    android:textSize="16sp"
                    android:textColor="@color/yenkasaBlack"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
