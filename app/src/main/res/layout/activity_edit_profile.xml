<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Yenkasa Amber Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:background="@color/yenkasaAmber"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <!-- IMPORTANT: match_parent so children can center -->
            <LinearLayout
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Profile Image container -->
                <RelativeLayout
                    android:layout_width="130dp"
                    android:layout_height="130dp">

                    <ImageView
                        android:id="@+id/imageProfile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/circle_avatar"
                        android:padding="6dp"
                        android:src="@drawable/default_avatar" />

                    <ImageView
                        android:id="@+id/btnChangeImage"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/circle_icon_bg"
                        android:padding="8dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@android:color/white" />

                </RelativeLayout>

                <!-- Name -->
                <TextView
                    android:id="@+id/textName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akua Ataa"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/yenkasaWhite"
                    android:layout_marginTop="8dp" />

                <!-- Phone -->
                <TextView
                    android:id="@+id/textPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+233 558 123 456"
                    android:textSize="14sp"
                    android:alpha="0.8"
                    android:textColor="@color/yenkasaWhite" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_margin="16dp"
            android:layout_marginTop="-60dp"
            android:orientation="vertical">

            <!-- Username -->
            <!-- Username -->
            <TextView
                android:id="@+id/labelUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="@color/inputLabel"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="none"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Akua Ataa"
                    android:textColor="@color/yenkasaBlack"
                    android:textSize="16sp"
                    android:background="@null"
                    android:imeOptions="actionDone"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email -->
            <TextView
                android:id="@+id/labelEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="@color/inputLabel"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="none"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="becca@gmail.com"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/yenkasaBlack"
                    android:textSize="16sp"
                    android:background="@null"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone -->
            <TextView
                android:id="@+id/labelPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:textColor="@color/inputLabel"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="none"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+233 558 123 456"
                    android:inputType="phone"
                    android:textColor="@color/yenkasaBlack"
                    android:textSize="16sp"
                    android:background="@null"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Location -->
            <TextView
                android:id="@+id/labelLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textColor="@color/inputLabel"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="none"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Abrepo"
                    android:textColor="@color/yenkasaBlack"
                    android:textSize="16sp"
                    android:background="@null"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Gender -->
            <TextView
                android:id="@+id/labelGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gender"
                android:textColor="@color/inputLabel"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="none"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Female"
                    android:textColor="@color/yenkasaBlack"
                    android:textSize="16sp"
                    android:background="@null"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Date of Birth -->
            <TextView
                android:id="@+id/labelDob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date of Birth"
                android:textColor="@color/inputLabel"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="none"
                android:paddingTop="4dp"
                android:paddingBottom="22dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editDob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="12/07/2001"
                    android:hint="YYYY-MM-DD"
                    android:textColor="@color/yenkasaBlack"
                    android:textSize="16sp"
                    android:background="@null"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- optional Save button (if you want) -->
            <!--
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/yenkasaEmerald"
                android:textColor="@color/yenkasaWhite"/>
            -->

            <!-- Change Password Row -->
            <LinearLayout
                android:id="@+id/rowPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:background="@drawable/row_bg"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iconLock"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/yenkasaEmerald" />

                <TextView
                    android:id="@+id/textChangePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Password"
                    android:textSize="16sp"
                    android:textColor="@color/yenkasaBlack"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
