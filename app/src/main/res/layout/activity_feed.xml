<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF5"
    android:padding="6dp">

    <!-- Smaller header text -->
    <TextView
        android:id="@+id/textCommunityHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="All Communities"
        android:textColor="#333333"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginBottom="6dp"/>

    <!-- Community selector (compact) -->
    <LinearLayout
        android:id="@+id/btnSelectCommunities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="@drawable/selector_bg">

        <TextView
            android:id="@+id/textCommunityNameHeader"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Communities"
            android:textColor="#222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_dropdown"
            app:tint="#333" />
    </LinearLayout>

    <TextView
        android:id="@+id/textSelectedCommunities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All"
        android:textColor="#555"
        android:textSize="12sp"
        android:paddingStart="8dp"
        android:paddingBottom="6dp" />

    <!-- Feed RecyclerView (no SwipeRefreshLayout wrapper) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewFeed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="86dp"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/progressBarFeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textEmptyFeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No posts yet."
            android:textSize="13sp"
            android:textColor="#777"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
