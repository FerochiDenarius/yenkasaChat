<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/feed_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/groupProfileHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/feed_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/buttonBackGroupProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chat_header_icon_button"
            android:contentDescription="Back"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/yenkasa_emerald" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Group Profile"
            android:textColor="@color/feed_primary_text"
            android:textSize="21sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/imageGroupProfile"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_profile_image_circle"
                android:contentDescription="Group image"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_profile" />

            <TextView
                android:id="@+id/textGroupProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/feed_primary_text"
                android:textSize="22sp"
                tools:text="Yenkasa Group" />

            <TextView
                android:id="@+id/textGroupProfileMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:textColor="@color/yenkasa_emerald"
                android:textSize="14sp"
                tools:text="12 members" />

            <TextView
                android:id="@+id/textGroupProfileBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chat_header_card"
                android:lineSpacingExtra="2dp"
                android:padding="16dp"
                android:textColor="@color/feed_secondary_text"
                android:textSize="14sp"
                tools:text="Group bio appears here." />

            <Button
                android:id="@+id/buttonAddGroupMembers"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chat_primary_button"
                android:drawableStart="@drawable/ic_person_add"
                android:drawablePadding="8dp"
                android:text="Add Members"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:text="Members"
                android:textColor="@color/feed_primary_text"
                android:textSize="17sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerGroupProfileMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
