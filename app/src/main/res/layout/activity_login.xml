<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1A12"
    tools:context=".ui.LoginActivity">

    <!-- ⭐ Background Stars -->
    <FrameLayout
        android:id="@+id/starContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Yenkasa Logo -->
            <ImageView
                android:id="@+id/imgChatIcon"
                android:transitionName="hero_chat_icon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="30dp"
                android:src="@drawable/ic_logo_emblem"
                android:contentDescription="Yenkasa Logo" />

            <!-- DARK CARD -->
            <LinearLayout
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="30dp"
                android:background="@drawable/card_dark_round"
                android:elevation="10dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back 👋"
                    android:textColor="#E5B326"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign to see what's happening in your community"
                    android:textColor="#AAAAAA"
                    android:textSize="15sp"
                    android:layout_marginBottom="28dp" />

                <!-- USERNAME FIELD  -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="none"
                    app:boxStrokeColor="@color/yellowAccent"
                    app:hintTextColor="@color/yellowAccent"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editLoginIdentifier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email"
                        android:textColor="#E5B326"
                        android:textColorHint="#E5B326"
                        android:padding="14dp"
                        android:background="@null" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- PASSWORD FIELD -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:passwordToggleEnabled="true"
                    app:boxBackgroundMode="none"
                    app:boxStrokeColor="@color/yellowAccent"
                    app:hintTextColor="@color/yellowAccent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editLoginPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:textColor="#E5B326"
                        android:textColorHint="#E5B326"
                        android:padding="14dp"
                        android:background="@null" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Forgot password -->
                <TextView
                    android:id="@+id/textForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot password?"
                    android:textStyle="bold"
                    android:textColor="#E5B326"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="end" />

                <!-- Login button -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="LOG IN"
                    android:textColor="#0E1A12"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_login_gold"
                    android:layout_marginTop="28dp"/>


                <!-- Loading Bar -->
                <ProgressBar
                    android:id="@+id/loginProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="14dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <!-- Register Section -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/textNoAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Don’t have an account?"
                        android:textColor="#AAAAAA" />

                    <TextView
                        android:id="@+id/textRegisterLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Sign Up"
                        android:textColor="@color/yellowAccent"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
