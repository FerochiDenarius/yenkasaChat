<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1A12"
    tools:context=".ui.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yellowAccent"
        android:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/yellowAccent"
            app:navigationIcon="@null"
        app:titleTextColor="#222"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_menu"
                app:tint="#222"/>

            <TextView
                android:id="@+id/toolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Yenkasa"
                android:textColor="#222"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/btnCreateAd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:padding="4dp"
                android:background="@drawable/bg_button_round">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ads_plus"
                    app:tint="@color/yenkasa_black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Ad"
                    android:textColor="@color/yenkasa_black"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

</com.google.android.material.appbar.AppBarLayout>

    <!-- FEED (now appears below toolbar — nothing overlaps) -->
<FrameLayout
android:id="@+id/feedContainer"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:paddingStart="6dp"
android:paddingEnd="6dp"
app:layout_behavior="@string/appbar_scrolling_view_behavior" />

<com.google.android.material.floatingactionbutton.FloatingActionButton
android:id="@+id/fabCreatePost"
android:layout_width="56dp"
android:layout_height="56dp"
android:layout_marginEnd="22dp"
android:layout_marginBottom="34dp"
android:rotation="-15"
app:layout_anchor="@id/feedContainer"
app:layout_anchorGravity="bottom|end"
android:contentDescription="Create Post"
app:srcCompat="@drawable/ic_add"
app:tint="#444"
android:backgroundTint="#FFF176"
android:elevation="8dp"
app:borderWidth="0dp"
app:useCompatPadding="true" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
