<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1A12"
    tools:context=".ui.MainActivity">

    <!-- AppBar / Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/yellowAccent"
        app:titleTextColor="#222222"
        android:elevation="6dp"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- LEFT: MENU BUTTON -->
            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_menu"
                android:layout_centerVertical="true"
                app:tint="#222" />

            <!-- CENTER: TITLE -->
            <TextView
                android:id="@+id/toolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yenkasa"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_centerInParent="true" />

            <!-- RIGHT: CREATE AD BUTTON -->
            <LinearLayout
                android:id="@+id/btnCreateAd"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="6dp"
                android:background="@drawable/bg_button_round">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_ads_plus"
                    app:tint="@color/yenkasa_black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Ad"
                    android:textColor="@color/yenkasa_black"
                    android:textSize="14sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>


    <!-- Feed container -->
    <FrameLayout
        android:id="@+id/feedContainer"
        android:layout_width="match_parent"
        android:layout_height="622dp"
        android:layout_marginBottom="88dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreatePost"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="34dp"
        android:rotation="-15"
        app:layout_anchor="@id/feedContainer"
        app:layout_anchorGravity="bottom|end"
        android:contentDescription="Create Post"
        app:srcCompat="@drawable/ic_add"
        app:tint="#444"
        android:backgroundTint="#FFF176"
        android:elevation="8dp"
        app:borderWidth="0dp"
        app:useCompatPadding="true" />




</androidx.coordinatorlayout.widget.CoordinatorLayout>
