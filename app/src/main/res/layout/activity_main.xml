<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1A12"
    tools:context=".ui.MainActivity">

    <!-- AppBar / Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:elevation="6dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/yellowAccent"
            app:titleTextColor="#222222"
            android:elevation="6dp"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Feed container -->
    <FrameLayout
        android:id="@+id/feedContainer"
        android:layout_width="match_parent"
        android:layout_height="622dp"
        android:layout_marginBottom="88dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreatePost"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="34dp"
        android:rotation="-15"
        app:layout_anchor="@id/feedContainer"
        app:layout_anchorGravity="bottom|end"
        android:contentDescription="Create Post"
        app:srcCompat="@drawable/ic_add"
        app:tint="#444"
        android:backgroundTint="#FFF176"
        android:elevation="8dp"
        app:borderWidth="0dp"
        app:useCompatPadding="true" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
