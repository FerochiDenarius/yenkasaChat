<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main Menu"
            android:textColor="#222222"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnCommunities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E0E0E0"
            android:textColor="#222222"
            android:text="Communities" />


        <Button
            android:id="@+id/btnContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E0E0E0"
            android:textColor="#222222"
            android:text="Contacts" />

        <Button
            android:id="@+id/btnChatRooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E0E0E0"
            android:textColor="#222222"
            android:text="Chat Rooms" />

        <Button
            android:id="@+id/btnAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E0E0E0"
            android:textColor="#222222"
            android:text="Account Info" />

        <!-- Edit Profile Button (neutral version) -->
        <Button
            android:id="@+id/btnCoinWallet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wallet"
            android:layout_marginTop="12dp"
            android:backgroundTint="#D5D5D5"
            android:textColor="#222222"/>

        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#D5D5D5"
            android:textColor="#222222"
            android:text="Edit Profile" />

        <Button
            android:id="@+id/btnVerifyAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E0E0E0"
            android:textColor="#222222"
            android:text="Verify Account" />


        <Button
            android:id="@+id/btnAppVerification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yenkasa Verification"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E0E0E0"
            android:textColor="#222222"/>

        <Button
            android:id="@+id/btnPostApproval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E0E0E0"
            android:textColor="#222222"
            android:text="Post Approvals" />


        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E0E0E0"
            android:textColor="#222222"
            android:text="Settings" />


        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#CCCCCC"
            android:textColor="#222222"
            android:text="Logout" />
    </LinearLayout>
</ScrollView>
