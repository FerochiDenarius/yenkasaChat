<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="22dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title -->
        <TextView
            android:text="@string/policy_welcome_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"/>

        <!-- Description -->
        <TextView
            android:text="@string/policy_intro"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"/>

        <!-- Links -->
        <TextView
            android:id="@+id/linkPrivacy"
            android:text="@string/privacy_policy"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/linkTerms"
            android:text="@string/user_agreement"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/linkGuidelines"
            android:text="@string/community_guidelines"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/linkSafety"
            android:text="@string/safety_policy"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/linkAds"
            android:text="@string/ads_rewarded_ads_disclosure"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <!-- Continue Button -->
        <Button
            android:id="@+id/btnAccept"
            android:text="@string/i_agree_and_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="12dp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"/>
    </LinearLayout>

</ScrollView>
