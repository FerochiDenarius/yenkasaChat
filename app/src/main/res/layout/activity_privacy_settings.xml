<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="26dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_privacy_header_icon"
                android:contentDescription="@string/message_privacy"
                android:padding="13dp"
                android:src="@drawable/ic_privacy"
                app:tint="@color/menu_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/message_privacy"
                    android:textColor="@color/menu_primary_text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/message_privacy_summary"
                    android:textColor="@color/menu_secondary_text"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/privacyOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_privacy_panel"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/optionEveryone"
                style="@style/PrivacyOptionRow">

                <View
                    android:id="@+id/indicatorEveryone"
                    style="@style/PrivacySelectionIndicator" />

                <ImageView
                    style="@style/PrivacyOptionIcon"
                    android:src="@drawable/ic_group"
                    app:tint="@color/menu_accent" />

                <LinearLayout
                    style="@style/PrivacyOptionTextColumn">

                    <TextView
                        style="@style/PrivacyOptionTitle"
                        android:text="@string/privacy_option_everyone_title" />

                    <TextView
                        style="@style/PrivacyOptionSubtitle"
                        android:text="@string/privacy_option_everyone_summary" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/PrivacyOptionDivider" />

            <LinearLayout
                android:id="@+id/optionCommunity"
                style="@style/PrivacyOptionRow">

                <View
                    android:id="@+id/indicatorCommunity"
                    style="@style/PrivacySelectionIndicator" />

                <ImageView
                    style="@style/PrivacyOptionIcon"
                    android:src="@drawable/ic_community_placeholder"
                    app:tint="@color/menu_accent" />

                <LinearLayout
                    style="@style/PrivacyOptionTextColumn">

                    <TextView
                        style="@style/PrivacyOptionTitle"
                        android:text="@string/privacy_option_community_title" />

                    <TextView
                        style="@style/PrivacyOptionSubtitle"
                        android:text="@string/privacy_option_community_summary" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/PrivacyOptionDivider" />

            <LinearLayout
                android:id="@+id/optionApproval"
                style="@style/PrivacyOptionRow">

                <View
                    android:id="@+id/indicatorApproval"
                    style="@style/PrivacySelectionIndicator" />

                <ImageView
                    style="@style/PrivacyOptionIcon"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/menu_accent" />

                <LinearLayout
                    style="@style/PrivacyOptionTextColumn">

                    <TextView
                        style="@style/PrivacyOptionTitle"
                        android:text="@string/privacy_option_approval_title" />

                    <TextView
                        style="@style/PrivacyOptionSubtitle"
                        android:text="@string/privacy_option_approval_summary" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_privacy_recommended_badge"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="@string/recommended"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View style="@style/PrivacyOptionDivider" />

            <LinearLayout
                android:id="@+id/optionNobody"
                style="@style/PrivacyOptionRow">

                <View
                    android:id="@+id/indicatorNobody"
                    style="@style/PrivacySelectionIndicator" />

                <ImageView
                    style="@style/PrivacyOptionIcon"
                    android:src="@drawable/ic_blocked"
                    app:tint="@color/menu_accent" />

                <LinearLayout
                    style="@style/PrivacyOptionTextColumn">

                    <TextView
                        style="@style/PrivacyOptionTitle"
                        android:text="@string/privacy_option_nobody_title" />

                    <TextView
                        style="@style/PrivacyOptionSubtitle"
                        android:text="@string/privacy_option_nobody_summary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/menu_secondary_text" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/privacy_existing_conversations_note"
                    android:textColor="@color/menu_secondary_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnSavePrivacy"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_privacy_save_button"
            android:text="@string/save_changes"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtMessageRequestsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/message_requests_count_zero"
                android:textColor="@color/menu_primary_text"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/message_requests_summary"
            android:textColor="@color/menu_secondary_text"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/messageRequestsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_privacy_panel"
            android:elevation="1dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/txtMessageRequestsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/no_message_requests"
            android:textColor="@color/menu_secondary_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/message_requests_private_note"
            android:textColor="@color/menu_secondary_text"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
