<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/register_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_root">

    <View
        android:id="@+id/registerGlowTop"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="-110dp"
        android:layout_marginEnd="-80dp"
        android:alpha="0.7"
        android:background="@drawable/bg_login_glow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/registerGlowBottom"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginStart="-100dp"
        android:layout_marginBottom="-90dp"
        android:alpha="0.35"
        android:background="@drawable/bg_login_glow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/starContainerRegister"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/registerScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="18dp"
        android:paddingTop="28dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/registerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/login_card_background"
                app:cardCornerRadius="28dp"
                app:cardElevation="10dp"
                app:strokeColor="@color/login_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="26dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <ImageView
                        android:id="@+id/registerHeroIcon"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_login_icon_tile"
                        android:padding="13dp"
                        android:src="@drawable/ic_register_book"
                        android:tint="@color/login_gold"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/textRegisterTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="22dp"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:text="@string/register_title"
                        android:textColor="@color/login_primary_text"
                        android:textSize="31sp"
                        android:textStyle="bold"
                        android:transitionName="hero_title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/register_subtitle"
                        android:textColor="@color/login_secondary_text"
                        android:textSize="16sp" />

                    <RadioGroup
                        android:id="@+id/radioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="30dp"
                        android:background="@drawable/bg_register_segment_group"
                        android:orientation="horizontal"
                        android:padding="2dp">

                        <RadioButton
                            android:id="@+id/radioEmail"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/selector_register_segment_bg"
                            android:button="@null"
                            android:checked="true"
                            android:drawableStart="@drawable/ic_register_mail"
                            android:drawablePadding="10dp"
                            android:drawableTint="@color/selector_register_segment_text"
                            android:gravity="center"
                            android:text="@string/email"
                            android:textColor="@color/selector_register_segment_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/radioPhone"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/selector_register_segment_bg"
                            android:button="@null"
                            android:drawableStart="@drawable/ic_register_phone"
                            android:drawablePadding="10dp"
                            android:drawableTint="@color/selector_register_segment_text"
                            android:gravity="center"
                            android:text="@string/phone"
                            android:textColor="@color/selector_register_segment_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutEmail"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:hint="@string/email_address"
                        app:boxBackgroundColor="@color/login_input_background"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/login_input_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/login_input_hint"
                        app:startIconDrawable="@drawable/ic_register_mail"
                        app:startIconTint="@color/login_gold">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editEmail"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:background="@null"
                            android:inputType="textEmailAddress"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/login_input_text"
                            android:textColorHint="@color/login_secondary_text"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPhone"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:hint="@string/phone_number"
                        android:visibility="gone"
                        app:boxBackgroundColor="@color/login_input_background"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/login_input_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/login_input_hint"
                        app:startIconDrawable="@drawable/ic_register_phone"
                        app:startIconTint="@color/login_gold">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPhone"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:background="@null"
                            android:inputType="phone"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/login_input_text"
                            android:textColorHint="@color/login_secondary_text"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutUsername"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/username"
                        app:boxBackgroundColor="@color/login_input_background"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/login_input_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/login_input_hint"
                        app:startIconDrawable="@drawable/ic_user_modern"
                        app:startIconTint="@color/login_gold">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editUsername"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:background="@null"
                            android:inputType="textPersonName"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/login_input_text"
                            android:textColorHint="@color/login_secondary_text"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/countryField"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_register_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_register_globe"
                            android:tint="@color/login_gold"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/country"
                                android:textColor="@color/login_secondary_text"
                                android:textSize="13sp" />

                            <Spinner
                                android:id="@+id/spinnerCountry"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@android:color/transparent"
                                android:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                                android:spinnerMode="dropdown" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textCommunityLabel"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/communityField"
                        android:layout_width="match_parent"
                        android:layout_height="82dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_register_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_register_pin"
                            android:tint="@color/login_gold"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/community_location_label"
                                android:textColor="@color/login_secondary_text"
                                android:textSize="13sp" />

                            <Spinner
                                android:id="@+id/spinnerCommunities"
                                android:layout_width="match_parent"
                                android:layout_height="42dp"
                                android:background="@android:color/transparent"
                                android:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                                android:spinnerMode="dropdown" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutLocation"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/location"
                        app:boxBackgroundColor="@color/login_input_background"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/login_input_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/login_input_hint"
                        app:startIconDrawable="@drawable/ic_register_pin"
                        app:startIconTint="@color/login_gold">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editLocation"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:background="@null"
                            android:inputType="textPostalAddress"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/login_input_text"
                            android:textColorHint="@color/login_secondary_text"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/password"
                        app:boxBackgroundColor="@color/login_input_background"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/login_input_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/login_secondary_text"
                        app:hintTextColor="@color/login_input_hint"
                        app:startIconDrawable="@drawable/ic_register_lock"
                        app:startIconTint="@color/login_gold">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPassword"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:background="@null"
                            android:inputType="textPassword"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/login_input_text"
                            android:textColorHint="@color/login_secondary_text"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutConfirmPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/confirm_password"
                        app:boxBackgroundColor="@color/login_input_background"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/login_input_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/login_secondary_text"
                        app:hintTextColor="@color/login_input_hint"
                        app:startIconDrawable="@drawable/ic_register_lock"
                        app:startIconTint="@color/login_gold">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:background="@null"
                            android:inputType="textPassword"
                            android:paddingStart="4dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/login_input_text"
                            android:textColorHint="@color/login_secondary_text"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/checkTerms"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:buttonTint="@color/login_gold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/i_agree_to_the"
                            android:textColor="@color/login_secondary_text"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/textTermsLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="5dp"
                            android:paddingBottom="10dp"
                            android:text="@string/user_agreement"
                            android:textColor="@color/login_gold"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textRegisterError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_register_error"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp"
                        android:textColor="@color/error_red"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:progressDrawable="@drawable/progress_emerald"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_login_button"
                        android:drawableEnd="@drawable/ic_arrow_forward_login"
                        android:drawableTint="@color/login_deep_green"
                        android:fontFamily="sans"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="@string/create_account"
                        android:textAllCaps="false"
                        android:textColor="@color/login_deep_green"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/already_have_account"
                            android:textColor="@color/login_secondary_text"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/textLoginLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="6dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="6dp"
                            android:paddingBottom="10dp"
                            android:text="@string/log_in"
                            android:textColor="@color/login_gold"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
