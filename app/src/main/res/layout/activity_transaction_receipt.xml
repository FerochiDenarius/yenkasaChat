<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wallet_background"
    tools:context=".ui.TransactionReceiptActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/buttonReceiptBack"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_wallet_pill"
                        android:clickable="true"
                        android:contentDescription="Back"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="11dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/wallet_primary_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="Transaction Receipt"
                            android:textColor="@color/wallet_primary_text"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textReceiptStatusSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:includeFontPadding="false"
                            android:text="Transaction Successful"
                            android:textColor="@color/wallet_accent_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/buttonReceiptShare"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_wallet_pill"
                        android:clickable="true"
                        android:contentDescription="Share"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="10dp"
                        android:src="@drawable/ic_share"
                        app:tint="@color/wallet_accent_green" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="162dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_wallet_hero">

                    <ImageView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="12dp"
                        android:alpha="0.28"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_coin" />

                    <ImageView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-26dp"
                        android:layout_marginEnd="-26dp"
                        android:alpha="0.16"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_coin" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <View
                            android:layout_width="92dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textReceiptTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Transaction Successful"
                                android:textColor="@color/wallet_accent_green"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textReceiptDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Your coins have been sent successfully."
                                android:textColor="@color/wallet_secondary_text"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textReceiptAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="- 10.00 YKC"
                                android:textColor="@color/wallet_primary_text"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textReceiptUsd"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="≈ $0.00 USD"
                                android:textColor="@color/wallet_secondary_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="-20dp"
                    android:background="@drawable/bg_transaction_copy_button"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_shield"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/wallet_accent_green"
                        android:text="Confirmed on-chain"
                        android:textColor="@color/wallet_accent_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="12 Confirmations"
                        android:textColor="@color/wallet_primary_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_wallet_transaction_status"
                        android:gravity="center"
                        android:text="Completed"
                        android:textColor="@color/wallet_accent_green"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Transaction Details"
                    android:textColor="@color/wallet_primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_wallet_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TransactionReceiptLabel"
                            android:text="Transaction ID" />

                        <TextView
                            android:id="@+id/textReceiptTransactionId"
                            style="@style/TransactionReceiptValue"
                            android:textColor="@color/wallet_accent_green"
                            tools:text="0xf83a...c2d9" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TransactionReceiptLabel"
                            android:text="Date &amp; Time" />

                        <TextView
                            android:id="@+id/textReceiptDate"
                            style="@style/TransactionReceiptValue"
                            tools:text="May 24, 2025 • 3:42 PM" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TransactionReceiptLabel"
                            android:text="Status" />

                        <TextView
                            android:id="@+id/textReceiptStatus"
                            style="@style/TransactionReceiptValue"
                            android:textColor="@color/wallet_accent_green"
                            tools:text="• Success" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TransactionReceiptLabel"
                            android:text="Network" />

                        <TextView
                            android:id="@+id/textReceiptNetwork"
                            style="@style/TransactionReceiptValue"
                            tools:text="Yenkasa Chain" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TransactionReceiptLabel"
                            android:text="Block Number" />

                        <TextView
                            android:id="@+id/textReceiptBlock"
                            style="@style/TransactionReceiptValue"
                            tools:text="#187,456" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TransactionReceiptLabel"
                            android:text="Confirmations" />

                        <TextView
                            android:id="@+id/textReceiptConfirmations"
                            style="@style/TransactionReceiptValue"
                            tools:text="12" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Transfer Summary"
                    android:textColor="@color/wallet_primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_wallet_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TransactionReceiptLabel"
                            android:text="From" />

                        <TextView
                            android:id="@+id/textReceiptFrom"
                            style="@style/TransactionReceiptValue"
                            tools:text="You\nYKC-KXL..." />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TransactionReceiptLabel"
                            android:text="To" />

                        <TextView
                            android:id="@+id/textReceiptTo"
                            style="@style/TransactionReceiptValue"
                            android:textColor="@color/wallet_accent_green"
                            tools:text="0x713a...d4e7" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TransactionReceiptLabel"
                            android:text="Amount" />

                        <TextView
                            android:id="@+id/textReceiptSummaryAmount"
                            style="@style/TransactionReceiptValue"
                            tools:text="10.00 YKC\n≈ $4.57 USD" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TransactionReceiptLabel"
                            android:text="Network Fee" />

                        <TextView
                            android:id="@+id/textReceiptFee"
                            style="@style/TransactionReceiptValue"
                            tools:text="0.10 YKC\n≈ $0.05 USD" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TransactionReceiptLabel"
                            android:text="Total" />

                        <TextView
                            android:id="@+id/textReceiptTotal"
                            style="@style/TransactionReceiptValue"
                            tools:text="10.10 YKC\n≈ $4.62 USD" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_transaction_secure_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_wallet_pill"
                        android:padding="9dp"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/wallet_accent_green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Secure &amp; Verified"
                            android:textColor="@color/wallet_primary_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="This transaction is recorded securely on the Yenkasa Chain."
                            android:textColor="@color/wallet_secondary_text"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:background="@drawable/bg_wallet_bottom_nav"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/navReceiptHome"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_wallet_nav_home"
                android:drawablePadding="4dp"
                android:drawableTint="@color/wallet_secondary_text"
                android:gravity="center"
                android:text="Home"
                android:textColor="@color/wallet_secondary_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/navReceiptWallet"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_wallet"
                android:drawablePadding="4dp"
                android:drawableTint="@color/wallet_secondary_text"
                android:gravity="center"
                android:text="Wallet"
                android:textColor="@color/wallet_secondary_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/navReceiptTransaction"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wallet_nav_active"
                android:drawableTop="@drawable/ic_receive"
                android:drawablePadding="4dp"
                android:drawableTint="@color/wallet_accent_green"
                android:gravity="center"
                android:text="Transact"
                android:textColor="@color/wallet_accent_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navReceiptReceive"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_receive"
                android:drawablePadding="4dp"
                android:drawableTint="@color/wallet_secondary_text"
                android:gravity="center"
                android:text="Receive"
                android:textColor="@color/wallet_secondary_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/navReceiptProfile"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_wallet_nav_profile"
                android:drawablePadding="4dp"
                android:drawableTint="@color/wallet_secondary_text"
                android:gravity="center"
                android:text="Profile"
                android:textColor="@color/wallet_secondary_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
