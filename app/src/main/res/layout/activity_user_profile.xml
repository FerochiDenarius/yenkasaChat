<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/account_background"
    tools:context=".ui.UserProfileActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="84dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageButton
                    android:id="@+id/btnUserProfileBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_profile_icon_button"
                    android:contentDescription="Back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/account_primary_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textHeaderUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/account_primary_text"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="nova" />

                    <ImageView
                        android:id="@+id/iconHeaderVerified"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_verified_check_small"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnUserProfileMore"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_profile_icon_button"
                    android:contentDescription="More"
                    android:padding="10dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/account_primary_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="14dp">

                    <FrameLayout
                        android:layout_width="116dp"
                        android:layout_height="116dp"
                        android:background="@drawable/bg_profile_avatar_ring"
                        android:padding="5dp">

                        <ImageView
                            android:id="@+id/imageProfile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ic_user_placeholder"
                            android:contentDescription="Profile photo"
                            android:scaleType="centerCrop"
                            android:src="@drawable/default_avatar" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_weight="1"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textPostsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/account_primary_text"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Posts"
                                android:textColor="@color/account_secondary_text"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutFollowersStat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textFollowersCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/account_primary_text"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Followers"
                                android:textColor="@color/account_secondary_text"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutFollowingStat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textFollowingCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/account_primary_text"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Following"
                                android:textColor="@color/account_secondary_text"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/account_primary_text"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="nova" />

                    <ImageView
                        android:id="@+id/iconVerified"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="7dp"
                        android:src="@drawable/ic_verified_check_small"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/account_secondary_text" />

                    <TextView
                        android:id="@+id/textLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/account_secondary_text"
                        android:textSize="15sp"
                        tools:text="Location" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/account_primary_text"
                    android:textSize="15sp"
                    tools:text="New here. Building something amazing." />

                <LinearLayout
                    android:id="@+id/rowExternalLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_link"
                        app:tint="@color/blue" />

                    <TextView
                        android:id="@+id/textExternalLink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/blue"
                        android:textSize="15sp"
                        tools:text="linktr.ee/nova" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowJoined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/account_secondary_text" />

                    <TextView
                        android:id="@+id/textJoined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/account_secondary_text"
                        android:textSize="15sp"
                        tools:text="Joined May 2024" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_profile_rank_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/account_accent_green" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Rising Creator"
                        android:textColor="@color/account_primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top 82%"
                        android:textColor="@color/account_accent_green"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/account_accent_green" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutConversationStreak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_profile_rank_pill"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/textConversationStreak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔥 Conversation Streak: 0 days"
                        android:textColor="@color/account_primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textConversationStreakSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Private metric. Partners are never shown."
                        android:textColor="@color/account_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnFollow"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1.2"
                        android:background="@drawable/bg_profile_follow_button"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Follow"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnMessage"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1.15"
                        android:background="@drawable/bg_profile_secondary_button"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Message"
                        android:textAllCaps="false"
                        android:textColor="@color/account_primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnBlock"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_profile_danger_button"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="Block"
                        android:textAllCaps="false"
                        android:textColor="@color/account_danger"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnProfileActionMore"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_profile_secondary_button"
                        android:contentDescription="More actions"
                        android:padding="15dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="@color/account_primary_text" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="26dp"
                android:background="@color/account_surface"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tabProfileGrid"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_profile_grid"
                        app:tint="@color/account_primary_text" />

                    <View
                        android:layout_width="72dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_profile_tab_indicator" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabProfileVideo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="17dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_video"
                        app:tint="@color/account_secondary_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabProfileTagged"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="17dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_wallet_nav_profile"
                        app:tint="@color/account_secondary_text" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="300dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerUserPosts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:padding="1dp"
                    android:visibility="gone"
                    tools:itemCount="9"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_post_preview"
                    tools:spanCount="3"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/layoutLoadingPosts"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ProgressBar
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/account_accent_green" />

                    <TextView
                        android:id="@+id/textPostsState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Loading posts..."
                        android:textColor="@color/account_secondary_text"
                        android:textSize="16sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/userProfileBottomNav"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_wallet_bottom_nav"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/navUserProfileHome"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/bg_wallet_nav_active"
            android:clickable="true"
            android:drawableTop="@drawable/ic_wallet_nav_home"
            android:drawablePadding="4dp"
            android:drawableTint="@color/wallet_accent_green"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Home"
            android:textColor="@color/wallet_accent_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navUserProfileSearch"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_wallet_nav_explore"
            android:drawablePadding="4dp"
            android:drawableTint="@color/wallet_secondary_text"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Search"
            android:textColor="@color/wallet_secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navUserProfileCreate"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_add"
            android:drawablePadding="4dp"
            android:drawableTint="@color/wallet_secondary_text"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Create"
            android:textColor="@color/wallet_secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navUserProfileWallet"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_wallet"
            android:drawablePadding="4dp"
            android:drawableTint="@color/wallet_secondary_text"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Wallet"
            android:textColor="@color/wallet_secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navUserProfileProfile"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_wallet_nav_profile"
            android:drawablePadding="4dp"
            android:drawableTint="@color/wallet_secondary_text"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Profile"
            android:textColor="@color/wallet_secondary_text"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
