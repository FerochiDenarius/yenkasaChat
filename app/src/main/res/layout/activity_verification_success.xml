<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/post_create_background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="156dp"
        android:layout_gravity="bottom"
        android:alpha="0.85"
        android:scaleType="fitXY"
        android:src="@drawable/bg_verification_success_waves" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="34dp"
        android:paddingTop="74dp"
        android:paddingBottom="36dp">

        <ImageView
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:contentDescription="Yenkasa"
            android:src="@drawable/ic_yenkasa_logo" />

        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="68dp"
            android:background="@drawable/bg_verification_success_halo">

            <ImageView
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_verification_success_circle"
                android:padding="24dp"
                android:src="@drawable/ic_check"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Verification Successful!"
            android:textColor="@color/wallet_primary_text"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Your account has been verified and is now secure."
            android:textColor="@color/post_create_secondary_text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_verification_success_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_verification_success_halo"
                android:padding="14dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/yenkasa_emerald" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Account Verified"
                    android:textColor="@color/yenkasa_emerald"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="You can now access all features and enjoy a seamless experience."
                    android:textColor="@color/wallet_primary_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnVerificationGoDashboard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="42dp"
            android:background="@drawable/bg_verify_primary_button"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="Go to Dashboard"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnVerificationGoWallet"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Go to Wallet"
            android:textColor="@color/yenkasa_emerald"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
