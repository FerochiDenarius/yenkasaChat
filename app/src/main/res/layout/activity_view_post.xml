<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutViewPost"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="16dp"
    tools:context=".ui.ViewActivity">

    <ScrollView
        android:id="@+id/scrollViewPost"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="8dp">

            <!-- 👤 Profile Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/imageProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_profile_placeholder"
                    android:scaleType="centerCrop"
                    android:background="@drawable/profile_circle_bg"
                    android:contentDescription="@string/profile_image" />

                <TextView
                    android:id="@+id/textUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="username"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/black" />

                <ImageView
                    android:id="@+id/imageVerifiedBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_verified"
                    android:visibility="gone"
                    android:contentDescription="@string/verified_badge" />
            </LinearLayout>

            <!-- 📝 Caption -->
            <TextView
                android:id="@+id/textCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This is a caption for a sample post."
                android:textColor="@color/black"
                android:textSize="15sp"
                android:paddingBottom="8dp" />

            <!-- 🎞️ MEDIA WRAPPER -->
            <FrameLayout
                android:id="@+id/mediaContainer"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@drawable/media_bg"
                android:layout_marginBottom="8dp">

                <!-- 🖼️ Image Placeholder -->
                <ImageView
                    android:id="@+id/imageMedia"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_image"
                    android:contentDescription="@string/post_media"
                    android:visibility="gone" />

                <!-- 🎬 Actual Video Player -->
                <VideoView
                    android:id="@+id/videoContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:background="@drawable/placeholder_video"
                    android:contentDescription="@string/post_video" />

                <!-- 🎧 Audio Placeholder -->
                <LinearLayout
                    android:id="@+id/audioLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/audioIcon"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ic_audio"
                        android:contentDescription="@string/audio_icon" />

                    <TextView
                        android:id="@+id/audioLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio Post"
                        android:textColor="@color/gray"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textBackgroundPost"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Text-only post with a color background"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/imageYenkasaWatermark"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.32"
                    android:clickable="false"
                    android:contentDescription="@null"
                    android:elevation="6dp"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_yenkasa_logo" />
            </FrameLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_light"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <!-- 👁️ Views + ❤️ Likes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textViews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👁️ 0"
                    android:textSize="14sp"
                    android:textColor="@color/gray"
                    android:padding="4dp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/textLikes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️ 0"
                    android:textSize="14sp"
                    android:textColor="@color/gray"
                    android:padding="4dp" />
            </LinearLayout>

            <!-- ➕ Follow FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabFollow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_person_add"
                android:contentDescription="Follow"
                app:backgroundTint="@color/yenkasa_black"
                app:tint="@color/yenkasa_amber" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
