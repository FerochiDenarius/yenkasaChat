<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFD54F"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.IntroActivity">

    <!-- Glow background effect behind logo -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/ic_yenkasa_foreground"
        android:layout_gravity="center"/>

    <!-- Yenkasa Logo -->
    <ImageView
        android:id="@+id/introLogo"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/ic_logo_emblem"
        android:layout_marginTop="-240dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="Yenkasa Africa Logo" />

    <!-- App Title -->
    <TextView
        android:id="@+id/textAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Yenkasa Africa"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium" />

    <!-- Tagline reflecting community awareness -->
    <TextView
        android:id="@+id/textTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="See what's happening in your community."
        android:textSize="17sp"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="40dp"
        android:alpha="0.8" />

    <!-- Get Started Button -->
    <Button
        android:id="@+id/buttonGetStarted"
        android:layout_width="260dp"
        android:layout_height="54dp"
        android:backgroundTint="#1A7F2E"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:elevation="6dp"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
