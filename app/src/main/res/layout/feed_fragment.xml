<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/feed_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutFeedCommunitiesBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/feed_surface"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewFeedCommunities"
            android:layout_width="match_parent"
            android:layout_height="98dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none"
            tools:itemCount="5"
            tools:listitem="@layout/item_feed_community_story" />

        <TextView
            android:id="@+id/textSelectedCommunities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/feed_secondary_text"
            android:textSize="11sp"
            tools:text="Music Lovers Ghana, Health Ghana" />
    </LinearLayout>

    <TextView
        android:id="@+id/textOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_feed_filter_bar"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="Offline mode: showing saved feed"
        android:textColor="@color/feed_secondary_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textCommunityNameHeader"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/feedFilterBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_feed_filter_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/tabForYou"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_feed_tab_selected"
            android:gravity="center"
            android:text="For You"
            android:textColor="@color/feed_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabFollowing"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_feed_tab_unselected"
            android:gravity="center"
            android:text="Following"
            android:textColor="@color/feed_secondary_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabTrending"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_feed_tab_unselected"
            android:gravity="center"
            android:text="Trending"
            android:textColor="@color/feed_secondary_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabLatest"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_feed_tab_unselected"
            android:gravity="center"
            android:text="Latest"
            android:textColor="@color/feed_secondary_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabTop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_feed_tab_unselected"
            android:gravity="center"
            android:text="Top"
            android:textColor="@color/feed_secondary_text"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewFeed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="164dp"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/progressBarFeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textEmptyFeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_feed_filter_bar"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:text="No posts yet."
            android:textColor="@color/feed_secondary_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBarFeedFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/floatingWalletCard"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_feed_wallet_float"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:minWidth="176dp"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/floatingWalletCoinContainer"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_feed_wallet_coin">

                    <ImageView
                        android:id="@+id/imageFloatingWalletCoin"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/feed_wallet_open"
                        android:src="@drawable/ic_coin" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textFloatingWalletLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/feed_wallet_label"
                        android:textColor="@color/wallet_secondary_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textFloatingWalletBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:textColor="@color/wallet_primary_text"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        tools:text="6,327" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutFloatingWalletSparkles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:orientation="horizontal"
                android:alpha="0"
                android:translationY="4dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_feed_wallet_spark" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_feed_wallet_spark" />

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/bg_feed_wallet_spark" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/layoutFloatingWalletDrops"
                android:layout_width="54dp"
                android:layout_height="58dp"
                android:layout_gravity="top|start"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/imageFloatingWalletDropOne"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|center_horizontal"
                    android:alpha="0"
                    android:src="@drawable/ic_coin" />

                <ImageView
                    android:id="@+id/imageFloatingWalletDropTwo"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="8dp"
                    android:alpha="0"
                    android:src="@drawable/ic_coin" />

                <ImageView
                    android:id="@+id/imageFloatingWalletDropThree"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:alpha="0"
                    android:src="@drawable/ic_coin" />
            </FrameLayout>

            <TextView
                android:id="@+id/textFloatingWalletDelta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/bg_feed_wallet_delta"
                android:includeFontPadding="false"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="@color/wallet_primary_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:translationY="8dp"
                android:visibility="gone"
                tools:text="+120 YKC" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
