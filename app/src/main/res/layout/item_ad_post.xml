<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="10dp"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="8dp">

    <!-- SPONSORED HEADER -->
    <TextView
        android:id="@+id/adSponsorLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sponsored_earn_5_ykc"
        android:textColor="@color/gray_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <!-- AD TITLE -->
    <TextView
        android:id="@+id/adTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/your_ad_title_here"
        android:layout_marginTop="4dp"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- MEDIA CONTAINER — Same as REAL posts -->
    <FrameLayout
        android:id="@+id/adMediaContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@android:color/black">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- IMAGE THUMBNAIL -->
            <ImageView
                android:id="@+id/adImageThumbnail"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="9:16"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:visibility="gone"
                android:src="@drawable/placeholder_image" />

            <!-- VIDEO THUMBNAIL -->
            <ImageView
                android:id="@+id/adVideoThumbnail"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="9:16"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:background="@android:color/black" />

            <!-- VIDEO PLAYER -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/adPlayerView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:use_controller="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="9:16"
                android:background="@android:color/black" />

            <!-- Play Button -->
            <ImageButton
                android:id="@+id/adPlayButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_play_circle"
                android:visibility="gone"
                app:tint="@android:color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <!-- CTA BUTTON -->
    <Button
        android:id="@+id/adCTAButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/learn_more"
        android:backgroundTint="@color/yenkasaEmerald"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:padding="10dp"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

    <!-- WATCH-TO-EARN BUTTON (Rewarded Ad) -->
    <Button
        android:id="@+id/adWatchRewardButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/watch_earn_default_ykc"
        android:backgroundTint="@color/yenkasa_amber"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:padding="10dp"
        android:layout_marginTop="6dp" />

    <FrameLayout
        android:id="@+id/admobNativeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/nativeAdView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/bg_yenkasa_native_card"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- HEADLINE -->
            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/yenkasa_black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="6dp"/>

            <!-- MEDIA -->
            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="@color/yenkasa_amber"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"/>

            <!-- CTA BUTTON -->
            <Button
                android:id="@+id/ad_call_to_action"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="@string/get_started"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="22dp"
                android:textColor="@color/yenkasaWhite"
                android:background="@drawable/bg_yenkasa_cta"
                android:backgroundTint="@null"
                android:layout_gravity="start"/>

        </LinearLayout>

    </com.google.android.gms.ads.nativead.NativeAdView>



</LinearLayout>
