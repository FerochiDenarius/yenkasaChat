<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_blocked_user_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- LEFT: Avatar -->
    <ImageView
        android:id="@+id/imgAvatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_user_placeholder"
        android:layout_marginEnd="12dp"
        android:contentDescription="Profile picture" />

    <!-- MIDDLE: Username, Role, Date -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtUsername"
            android:textSize="15sp"
            android:textColor="@color/menu_primary_text"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtUserRole"
            android:textColor="@color/menu_secondary_text"
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtDateBlocked"
            android:textColor="@color/menu_secondary_text"
            android:textSize="11sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- RIGHT: Unblock icon -->
    <!-- RIGHT: Unblock action area -->
    <LinearLayout
        android:id="@+id/layoutUnblock"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_unblock_button"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iconUnblock"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_unblock"
            android:contentDescription="Unblock user"
            app:tint="@color/white" />


        <TextView
            android:id="@+id/textUnblock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unblock"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>


</LinearLayout>
