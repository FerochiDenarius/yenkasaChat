<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_chat_media_selected_thumb">

    <ImageView
        android:id="@+id/imageSelectedThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/chat_media_preview"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/textSelectedNumber"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chat_media_selection_badge"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/buttonRemoveSelected"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_chat_media_toolbar_button"
        android:contentDescription="@string/chat_media_remove"
        android:padding="5dp"
        android:src="@drawable/ic_close"
        android:tint="@color/chat_picker_icon" />

</FrameLayout>
