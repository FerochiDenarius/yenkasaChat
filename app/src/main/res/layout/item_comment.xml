<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp"
    android:background="@color/transparent">

    <!-- Profile Image -->
    <ImageView
        android:id="@+id/imageUser"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="8dp"
        android:contentDescription="User profile image"
        android:scaleType="centerCrop"
        android:background="@drawable/profile_image_bg"
        android:src="@drawable/ic_user_placeholder" />

    <!-- Like Button (top right) -->
    <LinearLayout
        android:id="@+id/likeContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/buttonLike"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_heart_outline"
            android:contentDescription="Like comment"
            app:tint="@color/primary_color"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/textLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/gray"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Comment content -->
    <LinearLayout
        android:id="@+id/commentContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/imageUser"
        android:layout_toStartOf="@id/likeContainer"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This is a comment text."
            android:textColor="@color/dark_gray"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/textTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2h ago"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/buttonReply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • Reply"
                android:textColor="@color/blue"
                android:textSize="12sp"
                android:paddingStart="6dp" />

            <TextView
                android:id="@+id/buttonEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • Edit"
                android:textColor="@color/blue"
                android:textSize="12sp"
                android:paddingStart="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/buttonDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • Delete"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:paddingStart="6dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
