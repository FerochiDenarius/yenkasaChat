<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_account_surface"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/textGeneratedRoleLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/account_primary_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textGeneratedCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/menu_accent"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textGeneratedExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/account_secondary_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/buttonCopyCode"
        android:layout_width="96dp"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_account_primary_button"
        android:gravity="center"
        android:text="Copy"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
