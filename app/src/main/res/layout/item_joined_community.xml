<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:background="@color/account_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <ImageView
        android:id="@+id/imageCommunityIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_community_icon_tile"
        android:contentDescription="@string/community_icon_content_description"
        android:padding="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_community_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textCommunityName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/community_name_placeholder"
            android:textColor="@color/account_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textMemberCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/community_members_placeholder"
                android:textColor="@color/account_secondary_text"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/bullet_symbol"
                android:textColor="@color/account_accent_green"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textCommunityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/community_status_active"
                android:textColor="@color/account_secondary_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_account_circle_button"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/account_secondary_text" />
</LinearLayout>
