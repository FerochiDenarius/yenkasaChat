<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_live_event"
    android:gravity="center_vertical"
    android:minHeight="54dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/imageLiveEventAvatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_feed_media"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_default_profile" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textLiveEventText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E6F1EB"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textLiveEventTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#6E8D7E"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
