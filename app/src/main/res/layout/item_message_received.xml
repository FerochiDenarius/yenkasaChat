<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="56dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_message_received"
        android:elevation="2dp"
        android:maxWidth="292dp"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="9dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/textSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/yenkasa_emerald"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Ama Brown"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/replyLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:background="@drawable/reply_view_background"
            android:maxWidth="260dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/repliedToName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/yenkasa_emerald"
                android:textSize="12sp"
                tools:text="You" />

            <TextView
                android:id="@+id/repliedToMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:maxWidth="244dp"
                android:minLines="1"
                android:minWidth="160dp"
                android:textColor="@color/feed_primary_text"
                android:textSize="12sp"
                tools:text="Reply preview text" />
        </LinearLayout>

        <xyz.yenkasa.app.ui.chatmedia.YenkasaChatMediaView
            android:id="@+id/chatMediaView"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/audioContainer"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:background="@drawable/audio_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnPlayAudio"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/play_audio"
                android:src="@drawable/ic_play" />

            <SeekBar
                android:id="@+id/audioSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/audioDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="00:00"
                android:textColor="@color/feed_primary_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textContactInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/feed_primary_text"
                android:textSize="14sp"
                tools:text="John Doe - +123456789" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_location"
                android:textColor="@color/feed_primary_text"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="238dp"
            android:minWidth="42dp"
            android:textColor="@color/feed_primary_text"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="You’re inside now"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/feed_secondary_text"
                android:textSize="10sp"
                tools:text="12:37 AM" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
