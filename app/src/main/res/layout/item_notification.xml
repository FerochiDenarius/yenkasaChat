<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?android:selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/imgNotificationIcon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_notifications"
        app:tint="@color/yenkasa_black"/>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/txtNotificationMessage"
            android:text="Notification message..."
            android:textSize="14sp"
            android:textColor="@color/yenkasa_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtNotificationTime"
            android:text="Just now"
            android:textSize="11sp"
            android:textColor="@color/muted_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/imgUnreadIndicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/unread_dot"
        android:layout_marginStart="6dp"/>
</LinearLayout>
