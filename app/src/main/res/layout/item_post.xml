<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPostItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="12dp"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="8dp">

    <!-- 🧑 User Row -->
    <LinearLayout
        android:id="@+id/layoutUserInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imageProfilePost"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerCrop"
            android:background="@drawable/image_bg_rounded"
            android:src="@drawable/ic_profile_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textUsernamePost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/imageVerifiedBadge"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_verified"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/textCommunityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ayimensah Community"
                android:textColor="@color/gray"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textTimestampPost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2h ago"
            android:textColor="@color/gray"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ✍️ Post Text -->
    <TextView
        android:id="@+id/textPostContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="This is a post caption with @mention"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:lineSpacingExtra="2dp" />

    <!-- 🖼️ Post Image -->
    <ImageView
        android:id="@+id/imagePostContent"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:visibility="gone"
        android:background="@drawable/image_bg_rounded"
        tools:visibility="visible"
        tools:src="@drawable/placeholder_image" />

    <!-- 🎞️ Multiple Media Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMediaList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 💬 Engagement Row -->
    <LinearLayout
        android:id="@+id/layoutEngagement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <!-- ❤️ Like -->
        <ImageButton
            android:id="@+id/btnLike"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@null"
            android:src="@drawable/ic_heart_outline"
            android:contentDescription="Like" />

        <TextView
            android:id="@+id/textLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 likes"
            android:textColor="@color/gray_dark"
            android:textSize="14sp"
            android:layout_marginStart="4dp" />

        <!-- 💬 Comment -->
        <ImageButton
            android:id="@+id/btnComment"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="@null"
            android:src="@drawable/ic_comment"
            android:contentDescription="Comment" />

        <TextView
            android:id="@+id/textCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 comments"
            android:textColor="@color/gray_dark"
            android:textSize="14sp"
            android:layout_marginStart="4dp" />

        <!-- 🔗 Share -->
        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="@null"
            android:src="@drawable/ic_share"
            android:contentDescription="Share" />
    </LinearLayout>

    <!-- 🪙 Coins Earned -->
    <TextView
        android:id="@+id/textCoinsEarned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🪙 10 coins earned"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

</LinearLayout>
