<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutPostItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="10dp"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="8dp">

    <!-- User Row -->
    <LinearLayout
        android:id="@+id/layoutUserInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imageProfilePost"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerCrop"
            android:background="@drawable/image_bg_rounded"
            android:src="@drawable/ic_profile_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textUsernamePost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imageVerifiedBadge"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_verified"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/textCommunityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ayimensah Community"
                android:textColor="@color/gray"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textTimestampPost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2h"
            android:textColor="@color/gray"
            android:textSize="11sp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabFollow"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Follow user"
            app:backgroundTint="@color/primary"
            app:fabCustomSize="36dp"
            app:maxImageSize="18dp"
            app:srcCompat="@drawable/ic_person_add"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnMoreOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_more_vert"
            android:background="@null"
            android:contentDescription="More options"
            app:tint="@color/gray_dark"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textPostContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="This is a post caption with @mention"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:lineSpacingExtra="1.5dp" />

    <FrameLayout
        android:id="@+id/mediaContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <!-- 16:9 Aspect Ratio Wrapper -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- VIDEO THUMBNAIL -->
            <ImageView
                android:id="@+id/imageVideoThumbnail"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="9:16"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:background="@android:color/black" />

            <!-- CENTER PLAY ICON -->
            <ImageButton
                android:id="@+id/btnVideoPlay"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_play_circle"
                app:tint="@android:color/white"
                android:visibility="gone" />


            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="9:16"
                app:use_controller="true"
                app:controller_layout_id="@layout/custom_exo_controls"
                app:resize_mode="fill"
                android:visibility="gone"
                android:background="@android:color/black" />


            <!-- Image Post (same aspect ratio) -->
            <ImageView
                android:id="@+id/imagePostContent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="9:16"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:visibility="gone"
                android:background="@drawable/image_bg_rounded"
                tools:visibility="visible"
                tools:src="@drawable/placeholder_image" />

            <!-- Audio Placeholder -->
            <LinearLayout
                android:id="@+id/audioIcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:background="@drawable/image_bg_rounded"
                android:padding="12dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_audio_wave"
                    android:contentDescription="Audio Post"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/audioLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to Play Audio"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <!-- Play / Pause -->
                <ImageButton
                    android:id="@+id/btnAudioPlayPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:src="@drawable/ic_play_circle"
                    app:tint="@color/primary"
                    android:layout_marginTop="10dp" />

                <!-- SeekBar -->
                <SeekBar
                    android:id="@+id/audioSeekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="100" />

                <!-- Duration Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/audioCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/audioTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/textPostBackgroundContent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Text-only post with a color background"
                tools:visibility="visible" />

            <!-- Center Play Button -->
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:scaleType="centerInside"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_play_circle"
                app:tint="@android:color/white"
                android:visibility="gone" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <!-- Engagement Row -->
    <LinearLayout
        android:id="@+id/layoutEngagement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <!-- Like -->
        <ImageButton
            android:id="@+id/btnLike"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@null"
            android:src="@drawable/ic_heart_outline"
            android:contentDescription="Like" />

        <TextView
            android:id="@+id/textLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/gray_dark"
            android:textSize="13sp"
            android:layout_marginStart="6dp" />

        <ImageButton
            android:id="@+id/btnComment"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="14dp"
            android:background="@null"
            android:src="@drawable/ic_comment"
            android:contentDescription="Comment" />

        <TextView
            android:id="@+id/textCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/gray_dark"
            android:textSize="13sp"
            android:layout_marginStart="6dp" />

        <!-- Share -->
        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="14dp"
            android:background="@null"
            android:src="@drawable/ic_share"
            android:contentDescription="Share" />


        <TextView
            android:id="@+id/textViewCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="👁 0"
            android:textSize="13sp"
            android:textColor="@color/gray_dark"
            android:gravity="center_vertical" />



        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Coins Earned -->
    <TextView
        android:id="@+id/textCoinsEarned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🪙 10 coins earned"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

</LinearLayout>
