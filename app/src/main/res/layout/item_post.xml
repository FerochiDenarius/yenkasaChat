<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPostItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_feed_post_card"
    android:elevation="1dp"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/layoutUserInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageProfilePost"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/image_bg_rounded"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textUsernamePost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                android:textColor="@color/feed_primary_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="kofi" />

                <ImageView
                    android:id="@+id/imageVerifiedBadge"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/ic_verified"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textCommunityName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/feed_secondary_text"
                    android:textSize="12sp"
                    tools:text="Music Lovers Ghana" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:text="•"
                    android:textColor="@color/feed_secondary_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textTimestampPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/feed_secondary_text"
                    android:textSize="12sp"
                    tools:text="2h ago" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabFollow"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Follow user"
            app:backgroundTint="@color/feed_action_background"
            app:borderWidth="0dp"
            app:elevation="0dp"
            app:fabCustomSize="34dp"
            app:maxImageSize="17dp"
            app:srcCompat="@drawable/ic_person_add"
            app:tint="@color/feed_action_icon" />

            <ImageButton
                android:id="@+id/btnMoreOptions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_feed_icon_button"
            android:contentDescription="More options"
            android:padding="9dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/feed_primary_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/textPostContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/feed_primary_text"
        android:textSize="14sp"
        tools:text="Start your day with positive vibes and good energy. Your health is your real wealth." />

    <FrameLayout
        android:id="@+id/mediaContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_feed_media"
        android:clipToOutline="true"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageVideoThumbnail"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/black"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/black"
                android:visibility="gone"
                app:controller_layout_id="@layout/custom_exo_controls"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:resize_mode="fit"
                app:use_controller="true" />

            <ImageView
                android:id="@+id/imagePostContent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_feed_media"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintDimensionRatio="9:16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/placeholder_image"
                tools:visibility="visible" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/imageCarouselPostContent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_feed_media"
                android:visibility="gone"
                app:layout_constraintDimensionRatio="9:16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textImageCarouselCounter"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_feed_counter_badge"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingHorizontal="10dp"
                android:textColor="@color/feed_action_icon"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/imageCarouselPostContent"
                app:layout_constraintTop_toTopOf="@id/imageCarouselPostContent"
                tools:text="1/3"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/audioIcon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_feed_media"
                android:gravity="center"
                android:minHeight="210dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone"
                app:layout_constraintDimensionRatio="4:3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:contentDescription="Audio Post"
                    android:src="@drawable/ic_audio_wave"
                    app:tint="@color/feed_primary_text" />

                <TextView
                    android:id="@+id/audioLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap to Play Audio"
                    android:textColor="@color/feed_primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnAudioPlayPause"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_feed_icon_button"
                    android:src="@drawable/ic_play_circle"
                    app:tint="@color/feed_primary_text" />

                <SeekBar
                    android:id="@+id/audioSeekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/audioCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/feed_secondary_text"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/audioTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/feed_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textPostBackgroundContent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:gravity="center"
                android:padding="26dp"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintDimensionRatio="4:3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="we can all come together and build this as a team"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/btnVideoPlay"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@android:color/transparent"
                android:contentDescription="Play video"
                android:src="@drawable/ic_play_circle"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@android:color/transparent"
                android:contentDescription="Play or pause video"
                android:scaleType="centerInside"
                android:src="@drawable/ic_play_circle"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutEngagement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnLike"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_feed_icon_button"
            android:contentDescription="Like"
            android:padding="9dp"
            android:src="@drawable/ic_heart_outline"
            app:tint="@color/feed_secondary_text" />

        <TextView
            android:id="@+id/textLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/feed_secondary_text"
            android:textSize="12sp"
            tools:text="124 likes" />

        <ImageButton
            android:id="@+id/btnComment"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_feed_icon_button"
            android:contentDescription="Comment"
            android:padding="9dp"
            android:src="@drawable/ic_comment"
            app:tint="@color/feed_secondary_text" />

        <TextView
            android:id="@+id/textCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/feed_secondary_text"
            android:textSize="12sp"
            tools:text="18 comments" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_feed_icon_button"
            android:contentDescription="Share"
            android:padding="9dp"
            android:src="@drawable/ic_share"
            app:tint="@color/feed_secondary_text" />

        <TextView
            android:id="@+id/textViewCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:textColor="@color/feed_secondary_text"
            android:textSize="12sp"
            tools:text="7 shares" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:background="@color/feed_divider" />

    <TextView
        android:id="@+id/textCoinsEarned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/feed_primary_text"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="10 coins earned"
        tools:visibility="visible" />
</LinearLayout>
