<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:layout_marginBottom="8dp">

    <!-- This LinearLayout holds all the main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- User Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imageUser"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_contacts"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_bg"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/textUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111" />
        </LinearLayout>

        <!-- Caption -->
        <TextView
            android:id="@+id/textCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#333333"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Image -->
        <ImageView
            android:id="@+id/imagePost"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Video -->
        <VideoView
            android:id="@+id/videoPost"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Audio -->
        <ImageButton
            android:id="@+id/audioPlayButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_play"
            android:visibility="gone" />

        <!-- Interaction Row: Likes + Comments + Views + Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:paddingTop="6dp">

            <!-- Like -->
            <ImageButton
                android:id="@+id/buttonLike"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                android:src="@drawable/ic_heart_outline"
                android:contentDescription="Like" />

            <TextView
                android:id="@+id/textLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 likes"
                android:textColor="#444"
                android:textSize="14sp"
                android:layout_marginStart="4dp" />

            <!-- Comments -->
            <TextView
                android:id="@+id/textComments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • 0 comments"
                android:textColor="#555"
                android:textSize="14sp"
                android:layout_marginStart="8dp" />

            <!-- Views -->
            <TextView
                android:id="@+id/textViews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • 0 views"
                android:textColor="#555"
                android:textSize="14sp"
                android:layout_marginStart="6dp" />

            <!-- Spacer pushes timestamp to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Timestamp -->
            <TextView
                android:id="@+id/textTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2h ago"
                android:textColor="#777"
                android:textSize="12sp"
                android:paddingEnd="6dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- ✅ DELETE BUTTON MOVED HERE -->
    <!-- It's now a direct child of the RelativeLayout, allowing easy placement -->
    <ImageButton
        android:id="@+id/button_delete_post"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:padding="12dp"
        android:visibility="gone"
        android:contentDescription="Delete Post" />

</RelativeLayout>
