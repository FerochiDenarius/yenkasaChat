<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp">

    <ImageView
        android:id="@+id/imagePostPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:background="@drawable/bg_feed_media"
        android:contentDescription="@string/post_preview"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/textPostPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_feed_media"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="5"
        android:padding="10dp"
        android:textColor="@color/feed_primary_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iconPostPreviewType"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="7dp"
        android:background="@drawable/bg_feed_counter_badge"
        android:padding="5dp"
        android:visibility="gone"
        app:tint="@color/white" />
</FrameLayout>
