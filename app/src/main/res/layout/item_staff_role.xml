<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_account_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/textInitials"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_account_icon_green"
        android:gravity="center"
        android:text="YK"
        android:textColor="@color/account_accent_green"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/account_primary_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/account_secondary_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_account_icon_green"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/account_accent_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/buttonSuspend"
        android:layout_width="44dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_account_circle_button"
        android:gravity="center"
        android:text="X"
        android:textColor="#D32F2F"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/buttonMore"
        android:layout_width="44dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_account_circle_button"
        android:gravity="center"
        android:text="..."
        android:textColor="@color/account_primary_text"
        android:textSize="24sp"
        android:textStyle="bold" />
</LinearLayout>
