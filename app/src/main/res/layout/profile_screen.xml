<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/yenkasaAmber"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TOP PROFILE HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@color/yenkasaAmber">

            <TextView
                android:id="@+id/tvProfileTitle"
                android:text="Profile"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="35dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@drawable/ic_profile_placeholder"
                android:background="@drawable/circle_white"
                android:padding="4dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="75dp"/>

            <!-- USER NAME -->
            <TextView
                android:id="@+id/tvName"
                android:text="Becca William"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_below="@id/profileImage"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- PHONE -->
            <TextView
                android:id="@+id/tvPhone"
                android:text="+8800112234679"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:layout_below="@id/tvName"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </RelativeLayout>

        <!-- CONTENT BOX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_top_white"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- PROFILE ROWS -->
            <include
                android:id="@+id/rowEmail"
                layout="@layout/item_profile_row" />

            <include
                android:id="@+id/rowDob"
                layout="@layout/item_profile_row" />

            <include
                android:id="@+id/rowGender"
                layout="@layout/item_profile_row" />

            <include
                android:id="@+id/rowPhoneRow"
                layout="@layout/item_profile_row" />

            <include
                android:id="@+id/rowLocation"
                layout="@layout/item_profile_row" />

            <!-- CHANGE PASSWORD BUTTON -->
            <LinearLayout
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_gray_button"
                android:padding="15dp"
                android:layout_marginTop="25dp">

                <ImageView
                    android:src="@drawable/ic_lock"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    app:tint="@color/yenkasa_black"/>

                <TextView
                    android:text="Change Password"
                    android:textColor="@color/yenkasa_black"
                    android:textSize="16sp"
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
