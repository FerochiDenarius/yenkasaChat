<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/imagePlayerMedia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageAudioArtwork"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerMediaView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        app:resize_mode="fit"
        app:surface_type="texture_view"
        app:use_controller="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textPlayerContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:padding="28dp"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="168dp"
        android:background="@drawable/bg_yenkasa_player_gradient_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="340dp"
        android:background="@drawable/bg_yenkasa_player_gradient_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layoutPlayerTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imagePlayerLogo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="Yenkasa Logo"
            android:src="@drawable/ic_yenkasa_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="YENKASA"
            android:textColor="@android:color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/buttonPlayerMenu"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_yenkasa_player_glass"
            android:padding="12dp"
            android:src="@drawable/ic_menu"
            android:tint="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutPlayerCommunitiesPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_yenkasa_player_panel"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutPlayerTopBar">

        <LinearLayout
            android:id="@+id/layoutPlayerCommunitiesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Communities"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/buttonPlayerSeeAllCommunities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See all >"
                android:textColor="@color/wallet_accent_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <xyz.yenkasa.app.ui.player.YenkasaCommunityStrip
            android:id="@+id/playerCommunityStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <xyz.yenkasa.app.ui.player.YenkasaWalletPill
        android:id="@+id/playerWalletPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutPlayerCommunitiesPanel" />

    <xyz.yenkasa.app.ui.player.YenkasaSponsoredAdButton
        android:id="@+id/playerSponsoredAdButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerWalletPill" />

    <LinearLayout
        android:id="@+id/layoutPlayerEngagement"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_yenkasa_player_rail"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/layoutPlayerBottomMeta"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/buttonPlayerLike"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_yenkasa_player_glass"
            android:padding="11dp"
            android:src="@drawable/ic_heart_outline"
            android:tint="@color/wallet_accent_green" />

        <TextView
            android:id="@+id/textPlayerLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/buttonPlayerComment"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_yenkasa_player_glass"
            android:padding="11dp"
            android:src="@drawable/ic_comment"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/textPlayerCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/buttonPlayerShare"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_yenkasa_player_glass"
            android:padding="11dp"
            android:src="@drawable/ic_share"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/textPlayerShareCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/buttonPlayerSave"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_yenkasa_player_glass"
            android:padding="11dp"
            android:src="@drawable/ic_wallet_nav_rewards"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/textPlayerSaveCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/buttonPlayerReward"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_yenkasa_player_glass"
            android:padding="11dp"
            android:src="@drawable/ic_live_bolt"
            android:tint="@color/wallet_accent_green" />

        <TextView
            android:id="@+id/textPlayerRewardCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/wallet_accent_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <xyz.yenkasa.app.ui.player.YenkasaLiveArenaButton
        android:id="@+id/playerLiveArenaButton"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/layoutPlayerBottomMeta"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layoutPlayerBottomMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/layoutPlayerControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/imagePlayerAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/image_bg_rounded"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textPlayerUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imagePlayerVerified"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_verified"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/textPlayerCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:maxLines="2" />

            <TextView
                android:id="@+id/textPlayerSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/wallet_accent_green"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonPlayerMoreOptions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_yenkasa_player_glass"
            android:padding="10dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutPlayerControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <SeekBar
            android:id="@+id/playerSeekBar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:max="1000"
            android:progressTint="@color/wallet_accent_green"
            android:thumbTint="@color/wallet_accent_green" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textPlayerCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/textPlayerDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonPlayerPrevious"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_yenkasa_player_glass"
                android:padding="12dp"
                android:src="@drawable/ic_comment_edit"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/buttonPlayerPlayPause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="14dp"
                android:background="@drawable/bg_yenkasa_player_glass"
                android:padding="14dp"
                android:src="@drawable/ic_pause"
                android:tint="@color/wallet_accent_green" />

            <ImageButton
                android:id="@+id/buttonPlayerNext"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_yenkasa_player_glass"
                android:padding="12dp"
                android:rotation="180"
                android:src="@drawable/ic_comment_edit"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/buttonPlayerMute"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_yenkasa_player_glass"
                android:padding="12dp"
                android:src="@drawable/ic_volume_up"
                android:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
