<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_feed_media"
    android:clipToOutline="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/yenkasaVideoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <ImageView
        android:id="@+id/yenkasaVideoPoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_feed_media"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <View
        android:id="@+id/yenkasaVideoBottomGradient"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_yenkasa_player_gradient_bottom"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/yenkasaVideoLoading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/yenkasa_emerald"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/yenkasaVideoCenterPlay"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_feed_icon_button"
        android:contentDescription="@string/play_video"
        android:padding="13dp"
        android:src="@drawable/ic_play_circle"
        android:visibility="gone"
        app:tint="@color/feed_primary_text" />

    <LinearLayout
        android:id="@+id/yenkasaVideoControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/yenkasaVideoPlayPause"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_yenkasa_player_glass"
            android:contentDescription="@string/play_pause"
            android:padding="10dp"
            android:src="@drawable/ic_play_arrow"
            app:tint="@android:color/white" />

        <ProgressBar
            android:id="@+id/yenkasaVideoProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/yenkasa_emerald"
            android:progressBackgroundTint="#55FFFFFF" />

        <ImageButton
            android:id="@+id/yenkasaVideoMute"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_yenkasa_player_glass"
            android:contentDescription="@string/mute_or_unmute"
            android:padding="10dp"
            android:src="@drawable/ic_volume_off"
            app:tint="@android:color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/yenkasaVideoError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_chat_media_loading_chip"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="@string/video_failed_tap_retry"
        android:textColor="@color/feed_primary_text"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
