<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.YenkasaChat" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/yenkasa_amber</item>
        <item name="colorOnPrimary">@color/yenkasa_black</item>
        <item name="colorPrimaryVariant">@color/yenkasa_black</item>
        <item name="colorSecondary">@color/yenkasa_amber</item>
        <item name="colorOnSecondary">@color/yenkasa_black</item>
        <item name="colorAccent">@color/yenkasa_amber</item>
        <item name="android:colorAccent">@color/yenkasa_amber</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:textCursorDrawable">@drawable/cursor_color</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="materialButtonStyle">@style/YenkasaButton</item>
        <item name="android:buttonStyle">@style/YenkasaFrameworkButton</item>
        <item name="alertDialogTheme">@style/YenkasaAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/YenkasaAlertDialog</item>
    </style>

    <style name="Theme.Yenkasa.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
