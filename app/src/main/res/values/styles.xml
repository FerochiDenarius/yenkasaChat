<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Yenkasa brand colors. These also drive AlertDialog action text. -->
        <item name="colorPrimary">@color/yenkasa_black</item>
        <item name="colorOnPrimary">@color/yenkasa_amber</item>
        <item name="colorPrimaryVariant">@color/yenkasa_black</item>
        <item name="colorSecondary">@color/yenkasa_amber</item>
        <item name="colorOnSecondary">@color/yenkasa_black</item>
        <item name="colorAccent">@color/yenkasa_black</item>
        <item name="android:colorAccent">@color/yenkasa_black</item>
        <item name="colorSurface">@color/background_light</item>
        <item name="colorOnSurface">@color/yenkasa_black</item>
        <item name="android:textCursorDrawable">@drawable/cursor_color</item>


        <!-- Backgrounds -->
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@color/yenkasa_black</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>

        <item name="materialButtonStyle">@style/YenkasaButton</item>
        <item name="android:buttonStyle">@style/YenkasaFrameworkButton</item>
        <item name="alertDialogTheme">@style/YenkasaAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/YenkasaAlertDialog</item>
    </style>

    <!-- Transparent activity theme (unchanged) -->
    <style name="Theme.TransparentActivity" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Style for the new Posts, Followers, Following text -->
    <style name="ProfileStatValue" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <!-- Styles to clean up the detail rows (Email, Phone) -->
    <style name="ProfileDetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="ProfileDetailLabel" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ProfileDetailInputLayout">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="ProfileDetailInput" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="MenuItemStyle">
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?android:selectableItemBackground</item>
    </style>

    <style name="MenuItemStyleCompact">
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?android:selectableItemBackground</item>
    </style>

    <style name="YenkasaSectionHeader">
        <item name="android:textColor">@color/yenkasa_black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <!-- ========= No-tint Button Style (prevents Material from tinting your drawables) ========= -->
    <style name="NoTintButton" parent="Widget.Material3.Button">
        <!-- ensure both framework & support attributes are null so tinting stops -->
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <!-- keep default paddings/shape from Material if you want; we only remove the tint -->
    </style>

    <style name="YenkasaAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/yenkasa_dialog_action</item>
        <item name="colorOnSurface">@color/yenkasa_dialog_on_surface</item>
        <item name="buttonBarPositiveButtonStyle">@style/YenkasaDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/YenkasaDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/YenkasaDialogButton</item>
    </style>

    <style name="YenkasaDialogButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/yenkasa_dialog_action</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
    </style>

    <style name="CommunityCategoryChip" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:background">@drawable/bg_community_category_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:textColor">@color/account_primary_text</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TransactionReceiptLabel" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/wallet_secondary_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TransactionReceiptValue" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1.25</item>
        <item name="android:ellipsize">middle</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/wallet_primary_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PrivacyOptionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">82dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">?android:selectableItemBackground</item>
    </style>

    <style name="PrivacySelectionIndicator">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/bg_privacy_indicator_unselected</item>
    </style>

    <style name="PrivacyOptionIcon">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_privacy_option_icon</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="PrivacyOptionTextColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="PrivacyOptionTitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/menu_primary_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PrivacyOptionSubtitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textColor">@color/menu_secondary_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="PrivacyOptionDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">58dp</item>
        <item name="android:background">@color/menu_surface_stroke</item>
    </style>

    <style name="LiveStreamTabText" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_live_comment</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LiveActionRailItem">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="LiveActionRailButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_live_action_circle</item>
        <item name="android:elevation">9dp</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="LiveActionRailLabel" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">3</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">10sp</item>
    </style>

</resources>
