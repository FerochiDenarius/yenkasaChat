<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =========================
         YENKASA APP THEME
         ========================= -->
    <style name="Theme.Yenkasa" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- App colors -->
        <item name="colorPrimary">@color/yenkasa_black</item>
        <item name="colorOnPrimary">@color/yenkasa_amber</item>

        <item name="colorSecondary">@color/yenkasa_black</item>
        <item name="colorOnSecondary">@color/yenkasa_amber</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/yenkasa_black</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/yenkasa_black</item>
        <item name="android:navigationBarColor">@color/yenkasa_black</item>

        <!-- 🔥 GLOBAL BUTTON STYLE -->
        <item name="materialButtonStyle">@style/YenkasaButton</item>

    </style>

    <!-- =========================
         GLOBAL BUTTON STYLE
         ========================= -->
    <style name="YenkasaButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/yenkasa_black</item>
        <item name="android:backgroundTint">@color/yenkasa_black</item>
        <item name="android:textColor">@color/yenkasa_amber</item>
        <item name="iconTint">@color/yenkasa_amber</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="YenkasaFrameworkButton" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/yenkasa_black</item>
        <item name="android:textColor">@color/yenkasa_amber</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
