{
  "name": "regloginbackend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker:moderation": "node src/ai/workers/moderation.worker.js",
    "worker:yme": "node src/yme/workers/yme.worker.js",
    "migrate-media": "node scripts/migrateMediaToGcs.js",
    "upload:static-assets": "node scripts/uploadStaticAssetsToCloudinary.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint . --ignore-pattern node_modules --ignore-pattern public --ignore-pattern uploads",
    "format:check": "prettier --check src/app.js src/server.js src/config/apiRoutes.js src/middleware/errorHandler.js src/middleware/requestContext.js src/middleware/validate.js src/observability/*.js tests/observability.test.js routes/auth.js"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@google-cloud/storage": "^7.16.0",
    "@huggingface/transformers": "^4.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "agora-access-token": "^2.0.4",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.77.1",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-list-endpoints": "^7.1.1",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.1",
    "multer-storage-cloudinary": "^2.2.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "socket.io": "^4.8.1",
    "twilio": "^5.7.3"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.10"
  }
}
