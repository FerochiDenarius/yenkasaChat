<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Yenkasa Portfolio | Bright Kofi Ofosu Menya</title>
  <style>
    :root {
      --primary: #f8fafc;
      --secondary: #d7e4dd;
      --accent: #f2c94c;
      --accent-dark: #f59e0b;
      --green: #22c55e;
      --green-deep: #0b5d3b;
      --light: #07120f;
      --muted: #9fb2aa;
      --card: rgba(255, 255, 255, 0.075);
      --border: rgba(255, 255, 255, 0.13);
      --success: #16a34a;
      --shadow: 0 24px 60px rgba(0, 0, 0, 0.26);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background:
        linear-gradient(135deg, rgba(34, 197, 94, 0.16), transparent 24rem),
        linear-gradient(225deg, rgba(242, 201, 76, 0.12), transparent 28rem),
        linear-gradient(135deg, #06110e 0%, #0b1220 48%, #0f1c35 100%);
      color: var(--primary);
      line-height: 1.6;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: -30%;
      z-index: -1;
      background:
        linear-gradient(115deg, transparent 0 28%, rgba(34, 197, 94, 0.11) 34%, transparent 45%),
        linear-gradient(245deg, transparent 0 30%, rgba(242, 201, 76, 0.09) 38%, transparent 50%);
      filter: blur(18px);
      animation: backgroundShift 14s ease-in-out infinite alternate;
      pointer-events: none;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: min(1150px, 92%);
      margin: 0 auto;
    }

    .navbar {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(6, 17, 14, 0.82);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .nav-wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 0;
      gap: 16px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: #fff;
    }

    .brand-logo {
      width: 42px;
      height: 42px;
      object-fit: contain;
      border-radius: 14px;
      background: #fff;
      padding: 5px;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
    }

    .brand-text {
      display: inline-flex;
      flex-direction: column;
      line-height: 1.05;
      font-size: 1.05rem;
      font-weight: 800;
    }

    .brand-text span {
      color: var(--accent);
      font-size: 0.82rem;
      letter-spacing: 0;
    }

    .nav-links {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
      align-items: center;
    }

    .nav-links a {
      color: var(--secondary);
      font-weight: 600;
      font-size: 0.95rem;
    }

    .nav-links a:hover {
      color: var(--accent-dark);
    }

    .hero {
      position: relative;
      overflow: hidden;
      padding: 86px 0 58px;
      background:
        linear-gradient(120deg, rgba(11, 93, 59, 0.42), transparent 44%),
        linear-gradient(315deg, rgba(245, 158, 11, 0.18), transparent 42%);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 32px;
      align-items: center;
    }

    .hero-text h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      line-height: 1.1;
      margin-bottom: 16px;
      opacity: 0;
      transform: translateY(34px);
      animation: fadeUp 0.9s ease forwards;
    }

    .hero-text h1 span {
      color: var(--accent);
      text-shadow: 0 0 28px rgba(242, 201, 76, 0.22);
    }

    .hero-text p {
      font-size: 1.06rem;
      color: var(--secondary);
      max-width: 650px;
      margin-bottom: 24px;
      opacity: 0;
      transform: translateY(24px);
      animation: fadeUp 0.9s ease 0.16s forwards;
    }

    .hero-actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 24px;
      opacity: 0;
      transform: translateY(22px);
      animation: fadeUp 0.9s ease 0.3s forwards;
    }

    .btn {
      display: inline-block;
      padding: 14px 22px;
      border-radius: 12px;
      font-weight: 700;
      transition: 0.25s ease;
    }

    .btn-primary {
      background: linear-gradient(45deg, var(--green-deep), var(--green));
      color: #fff;
      box-shadow: 0 14px 34px rgba(34, 197, 94, 0.22);
    }

    .btn-primary:hover {
      background: linear-gradient(45deg, var(--green), var(--accent));
      color: white;
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 18px 44px rgba(34, 197, 94, 0.35);
    }

    .btn-outline {
      border: 1px solid rgba(34, 197, 94, 0.48);
      background: rgba(255, 255, 255, 0.04);
      color: #d9f99d;
    }

    .btn-outline:hover {
      border-color: var(--accent);
      color: var(--accent-dark);
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-top: 20px;
    }

    .stat-card,
    .project-card,
    .skill-card,
    .contact-card,
    .review-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(16px);
    }

    .stat-card {
      padding: 18px;
      text-align: center;
    }

    .stat-card h3 {
      font-size: 1.4rem;
      color: var(--accent);
      margin-bottom: 6px;
    }

    .hero-visual {
      background: rgba(255, 255, 255, 0.075);
      color: white;
      padding: 28px;
      border-radius: 28px;
      box-shadow: var(--shadow);
      border: 1px solid rgba(255, 255, 255, 0.14);
      backdrop-filter: blur(18px);
      opacity: 0;
      transform: translateX(36px);
      animation: fadeSide 0.9s ease 0.22s forwards;
    }

    .hero-visual h3 {
      font-size: 1.4rem;
      margin-bottom: 14px;
      color: #fde68a;
    }

    .hero-logo {
      width: min(270px, 100%);
      margin-bottom: 22px;
      border-radius: 24px;
      background: #fff;
      padding: 14px;
      box-shadow: 0 24px 50px rgba(0, 0, 0, 0.22);
    }

    .hero-visual p {
      color: #cbd5e1;
      margin-bottom: 20px;
    }

    .stack-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .pill {
      padding: 10px 14px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 999px;
      font-size: 0.92rem;
    }

    section {
      padding: 70px 0;
    }

    .section-header {
      margin-bottom: 28px;
    }

    .section-header h2 {
      font-size: clamp(1.6rem, 4vw, 2.5rem);
      margin-bottom: 10px;
    }

    .section-header p {
      color: var(--muted);
      max-width: 760px;
    }

    .projects-grid,
    .skills-grid,
    .contact-grid,
    .reviews-grid {
      display: grid;
      gap: 22px;
    }

    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }

    .reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .project-card,
    .skill-card,
    .contact-card,
    .review-card {
      padding: 24px;
    }

    .project-card h3,
    .skill-card h3,
    .contact-card h3,
    .review-card h3 {
      margin-bottom: 10px;
    }

    .project-card p,
    .skill-card p,
    .contact-card p,
    .review-card p {
      color: var(--muted);
      margin-bottom: 16px;
    }

    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 18px;
    }

    .tag {
      background: rgba(242, 201, 76, 0.12);
      color: #fde68a;
      border: 1px solid rgba(242, 201, 76, 0.22);
      padding: 7px 12px;
      border-radius: 999px;
      font-size: 0.86rem;
      font-weight: 700;
    }

    .project-links {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .project-links a,
    .contact-card a {
      color: var(--accent-dark);
      font-weight: 700;
    }

    .download-box {
      background: linear-gradient(135deg, rgba(11, 93, 59, 0.85), rgba(15, 23, 42, 0.92));
      color: white;
      padding: 26px;
      border-radius: 24px;
      margin-top: 24px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .download-box p {
      color: #e2e8f0;
      margin: 12px 0 18px;
    }

    .reviews {
      background: rgba(255, 255, 255, 0.035);
    }

    .review-form {
      margin-top: 24px;
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      border-radius: 22px;
      padding: 24px;
      backdrop-filter: blur(16px);
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 16px;
    }

    input, textarea, select {
      width: 100%;
      padding: 14px 16px;
      border-radius: 14px;
      border: 1px solid #cbd5e1;
      font: inherit;
      background: rgba(255, 255, 255, 0.92);
      color: #0f172a;
    }

    textarea {
      min-height: 140px;
      resize: vertical;
    }

    .full {
      grid-column: 1 / -1;
    }

    .footer {
      background: rgba(6, 17, 14, 0.92);
      color: #cbd5e1;
      text-align: center;
      padding: 30px 16px;
      margin-top: 30px;
    }

    .footer strong {
      color: white;
    }

    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes fadeUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeSide {
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes backgroundShift {
      from {
        transform: translate3d(-1.5rem, -1rem, 0) rotate(0deg);
      }
      to {
        transform: translate3d(1.5rem, 1rem, 0) rotate(2deg);
      }
    }

    @media (max-width: 950px) {
      .hero-grid,
      .projects-grid,
      .skills-grid,
      .contact-grid,
      .reviews-grid,
      .form-grid {
        grid-template-columns: 1fr;
      }

      .hero-stats {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .nav-wrap {
        flex-direction: column;
        align-items: flex-start;
      }

      .nav-links {
        gap: 12px;
      }

      .hero {
        padding-top: 42px;
      }
    }
  </style>
</head>
